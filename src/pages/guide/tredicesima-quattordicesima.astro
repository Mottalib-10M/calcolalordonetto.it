          <th class="py-3 px-4 text-center font-semibold text-gray-700 dark:text-gray-300">mensilità totali</th>
          <th class="py-3 pl-4 text-center font-semibold text-gray-700 dark:text-gray-300">Periodo erogazione quattordicesima</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
        <tr>
          <td class="py-3 pr-4 text-gray-900 dark:text-gray-100 font-medium">Commercio (Confcommercio)</td>
          <td class="py-3 px-4 text-center text-gray-900 dark:text-gray-100">14</td>
          <td class="py-3 pl-4 text-center text-gray-900 dark:text-gray-100">Luglio</td>
        </tr>
        <tr>
          <td class="py-3 pr-4 text-gray-900 dark:text-gray-100 font-medium">Turismo e Pubblici Esercizi</td>
          <td class="py-3 px-4 text-center text-gray-900 dark:text-gray-100">14</td>
