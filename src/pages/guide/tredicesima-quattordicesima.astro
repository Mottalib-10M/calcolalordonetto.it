          <td class="py-3 pl-4 text-center text-gray-900 dark:text-gray-100">Luglio</td>
        </tr>
        <tr>
          <td class="py-3 pr-4 text-gray-900 dark:text-gray-100 font-medium">Logistica e Trasporti</td>
