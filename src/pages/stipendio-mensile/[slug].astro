---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../config';
import { calcolaLordoDaNetto, calcolaStipendio, calcolaIRPEF } from '../../lib/irpef-engine';
import { regioni } from '../../data/regioni';
import { breadcrumbSchema, faqSchema } from '../../lib/seo';

export function getStaticPaths() {
  const amounts = [
    1000, 1200, 1300, 1400, 1500, 1600, 1700, 1800,
    2000, 2200, 2500, 2800, 3000, 3500, 4000, 5000,
  ];

  return amounts.map((netto) => ({
    params: { slug: `${netto}-euro` },
    props: { nettoTarget: netto },
  }));
}

interface Props {
  nettoTarget: number;
}

const { nettoTarget } = Astro.props;
const { slug } = Astro.params;

const defaultRegione = 'LOM';

// Main calculation
const { ral: ralDefault, risultato: defaultResult } = calcolaLordoDaNetto(nettoTarget, defaultRegione);

// Calculate for all regions
const regionResults = regioni.map((r) => {
  const { ral, risultato } = calcolaLordoDaNetto(nettoTarget, r.codice);
  return {
    codice: r.codice,
    nome: r.nome,
    ral,
    nettoMensile: risultato.nettoMensile,
    addizionaleRegionale: risultato.addizionaleRegionale,
    aliquotaMedia: risultato.aliquotaMedia,
  };
}).sort((a, b) => a.ral - b.ral);

// Detailed breakdown for default scenario
const dettaglio = calcolaStipendio({ ral: ralDefault, regione: defaultRegione });
const irpefDetail = calcolaIRPEF(dettaglio.imponibileFiscale - dettaglio.cuneoFiscaleSommaEsente);

// Format helpers
const fmtCur = (v: number) => v.toLocaleString('it-IT', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmtCurRound = (v: number) => v.toLocaleString('it-IT', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
const fmtPct = (v: number) => (v * 100).toLocaleString('it-IT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '%';

// Adjacent amounts for navigation
const allAmounts = [1000, 1200, 1300, 1400, 1500, 1600, 1700, 1800, 2000, 2200, 2500, 2800, 3000, 3500, 4000, 5000];
const currentIndex = allAmounts.indexOf(nettoTarget);
const prevAmount = currentIndex > 0 ? allAmounts[currentIndex - 1] : null;
const nextAmount = currentIndex < allAmounts.length - 1 ? allAmounts[currentIndex + 1] : null;

// Market context based on salary level
function getMarketContext(netto: number): { livello: string; settori: string; contesto: string } {
  if (netto <= 1200) return {
    livello: 'entry-level',
    settori: 'commercio, ristorazione, servizi alla persona, assistenza clienti',
    contesto: 'Questo livello retributivo è tipico di posizioni junior o part-time nel settore terziario. Secondo i dati ISTAT, circa il 25% dei lavoratori dipendenti italiani percepisce uno stipendio netto inferiore a 1.200 euro mensili.',
  };
  if (netto <= 1500) return {
    livello: 'medio-basso',
    settori: 'impiegati amministrativi, operai specializzati, commercio organizzato, logistica',
    contesto: 'Si tratta della fascia retributiva più diffusa in Italia. Secondo ISTAT, lo stipendio mediano netto dei lavoratori dipendenti si colloca intorno ai 1.400 euro mensili. Questo livello è comune per impiegati con 2-5 anni di esperienza.',
  };
  if (netto <= 1800) return {
    livello: 'medio',
    settori: 'industria manifatturiera, servizi professionali, pubblica amministrazione, bancario junior',
    contesto: 'Una retribuzione nella media nazionale per lavoratori dipendenti a tempo pieno. Questo livello è tipico di profili con esperienza intermedia (5-10 anni) o di ruoli specializzati nel settore industriale e dei servizi.',
  };
  if (netto <= 2200) return {
    livello: 'medio-alto',
    settori: 'IT e tecnologia, consulenza, ingegneria, settore bancario e assicurativo, farmaceutico',
    contesto: 'Sopra la media nazionale. Questo livello retributivo è tipico di professionisti qualificati con esperienza significativa, quadri intermedi, o ruoli tecnici specializzati nel Nord Italia. Il costo della vita nelle grandi città del Nord va tuttavia considerato.',
  };
  if (netto <= 3000) return {
    livello: 'alto',
    settori: 'management, IT senior, consulenza strategica, finanza, dirigenza PMI, medici specialisti',
    contesto: 'Ben sopra la media nazionale, questo livello retributivo riguarda meno del 10% dei lavoratori dipendenti italiani. È tipico di ruoli dirigenziali, professionisti senior nel settore tecnologico e finanziario, o quadri con responsabilità significative.',
  };
  return {
    livello: 'molto alto',
    settori: 'top management, direzione aziendale, consulenza direzionale, finanza strutturata, medici primari',
    contesto: 'Nella fascia più alta delle retribuzioni da lavoro dipendente in Italia, questo livello riguarda meno del 3% dei lavoratori. È tipico di dirigenti, C-level in aziende medio-grandi, o professionisti di altissimo livello in settori ad alta remunerazione.',
  };
}

const market = getMarketContext(nettoTarget);

/* ── Per-amount unique content — job profiles & financial context ───────── */

const nettoProfiles: Record<number, { jobs: string; finance: string }> = {
  1000: {
    jobs: 'Uno stipendio netto di 1.000 euro al mese (circa ' + fmtCurRound(ralDefault) + ' euro di RAL) è tipico di contratti part-time nel commercio al dettaglio (CCNL Commercio, livello 6-7 a orario ridotto), tirocini extracurriculari retribuiti, collaborazioni nel settore della ristorazione e contratti a chiamata nel turismo stagionale. È anche la retribuzione di apprendisti nel primo anno in molti settori del terziario, operatori di call center con orario ridotto, e addetti alle pulizie con contratto part-time. Nelle cooperative sociali, corrisponde a educatori o animatori con contratto a 25-30 ore settimanali.',
    finance: 'Con 1.000 euro netti al mese la priorità assoluta è il controllo rigoroso delle spese fisse. L\'affitto non dovrebbe superare i 350 euro, il che rende necessaria la condivisione dell\'alloggio in quasi tutte le città italiane, o la convivenza familiare. Le spese alimentari vanno contenute entro i 200-250 euro mensili, sfruttando mercati rionali, offerte settimanali e pasti preparati in casa. A questo livello di reddito è fondamentale verificare l\'accesso alle agevolazioni legate all\'ISEE: bonus bollette (risparmio stimato di 150-200 euro/anno), riduzione della TARI, esenzione dal ticket sanitario. Il risparmio è difficile ma non impossibile: anche 50 euro al mese in un conto deposito vincolato possono costruire un fondo emergenza di 600 euro in un anno, sufficiente per piccoli imprevisti.',
  },
  1200: {
    jobs: 'Un netto di 1.200 euro mensili (RAL circa ' + fmtCurRound(ralDefault) + ' euro) è la retribuzione di commessi e cassieri full-time nel CCNL Commercio (livello 5), operai generici nell\'industria alimentare, receptionist in strutture alberghiere, assistenti di studio medico, e segretari con contratto full-time nel terziario. Nel settore pubblico, corrisponde agli operatori (ex categoria B) nelle prime classi stipendiali. È anche il netto tipico di OSS (operatori socio-sanitari) nelle RSA con contratto cooperativo, e di addetti alla vendita in catene di abbigliamento.',
    finance: 'Con 1.200 euro netti al mese, il budget mensile va pianificato con attenzione: circa 400-450 euro per l\'abitazione (affitto in città medio-piccole o stanza in condivisione nelle grandi città), 200-250 euro per alimentari, 100 euro per trasporti e utenze. Restano circa 250-300 euro per spese personali e risparmio. L\'obiettivo primario dovrebbe essere la costruzione di un fondo emergenza di almeno 3.600 euro (tre mensilità). Il trattamento integrativo (100 euro/mese) è generalmente spettante e già incluso nel netto: verificarne la presenza in busta paga. Per risparmiare sulle bollette, valutare il mercato libero dell\'energia confrontando le offerte su ARERA.',
  },
  1300: {
    jobs: 'Con 1.300 euro netti al mese (RAL circa ' + fmtCurRound(ralDefault) + ' euro) troviamo impiegati amministrativi junior, operai specializzati nell\'edilizia, tecnici di laboratorio di primo livello, addetti alla logistica con esperienza, e assistenti educativi nelle scuole. Nel CCNL Metalmeccanico corrisponde al livello C1 con qualche anno di anzianità. È anche lo stipendio di molti neoassunti nel settore assicurativo (impiegati di agenzia), parrucchieri ed estetiste con contratto da dipendente in saloni strutturati, e autisti di linee urbane nei primi anni di servizio.',
    finance: 'Con 1.300 euro netti al mese si raggiunge il primo livello di flessibilità finanziaria. Dopo aver coperto le spese essenziali (affitto 400-500 euro, alimentari 250 euro, utenze e trasporti 150 euro), restano circa 400-500 euro per spese discrezionali e risparmio. Iniziare un Piano di Accumulo Capitale (PAC) con versamenti di 100 euro/mese su un ETF azionario globale a basso costo può generare circa 20.000 euro in 15 anni (con rendimento medio storico del 7%). A questo livello, la sottoscrizione del fondo pensione di categoria è particolarmente vantaggiosa grazie al contributo del datore di lavoro (tipicamente 1-2% della RAL), che rappresenta un beneficio netto aggiuntivo.',
  },
  1400: {
    jobs: 'Uno stipendio di 1.400 euro netti al mese (RAL circa ' + fmtCurRound(ralDefault) + ' euro) corrisponde alla mediana italiana e rappresenta la retribuzione di impiegati contabili, geometri con esperienza, infermieri nei primi anni di carriera nel settore pubblico, tecnici informatici di primo livello (help desk, supporto IT), e impiegati bancari al 3° livello. Nel CCNL Commercio siamo al livello 3-4 con anzianità, mentre nel Metalmeccanico al livello C2-C3. È anche lo stipendio tipico di insegnanti di scuola primaria nei primi 10 anni di ruolo e di grafici con esperienza in agenzie piccole.',
    finance: 'Con 1.400 euro netti al mese, lo stipendio si allinea alla mediana nazionale. La regola del 50/30/20 applicata a questo livello prevede: ' + fmtCurRound(1400 * 0.5) + ' euro per spese necessarie, ' + fmtCurRound(1400 * 0.3) + ' euro per desideri, ' + fmtCurRound(1400 * 0.2) + ' euro per risparmio e investimenti. Il fondo emergenza ideale è di ' + fmtCurRound(1400 * 4) + ' euro (4 mensilità). A questo livello di RAL, il cuneo fiscale prevede ancora la detrazione aggiuntiva di 1.000 euro/anno: è importante verificare che venga applicata correttamente in busta paga. Per l\'affitto, nelle città del Nord si arriva facilmente al 40% del netto, ben oltre la soglia consigliata del 30%: valutare periferie ben collegate o città satelliti.',
  },
  1500: {
    jobs: 'Un netto di 1.500 euro al mese (RAL circa ' + fmtCurRound(ralDefault) + ' euro) è la retribuzione di profili come contabili senior, tecnici commerciali nel B2B, sviluppatori web junior, coordinatori di reparto nella grande distribuzione, e periti industriali con esperienza. Nel settore pubblico corrisponde ai funzionari (ex categoria D) nelle prime classi stipendiali. È anche lo stipendio di insegnanti di scuola secondaria con 10-15 anni di servizio, fisioterapisti in ambito privato con contratto dipendente, e addetti al marketing con 2-3 anni di esperienza.',
    finance: 'Con 1.500 euro netti al mese si supera la mediana nazionale e si entra in una fascia dove il risparmio strutturato diventa realistico. Allocando 300 euro/mese tra fondo pensione (contributo volontario deducibile) e PAC su ETF, in 20 anni si può accumulare un capitale superiore ai 100.000 euro. A questo livello di RAL, attenzione alla soglia IRPEF dei 28.000 euro: se la RAL è appena sotto, un aumento che la porti oltre comporta il passaggio all\'aliquota marginale del 33% sull\'eccedenza. I buoni pasto (se previsti) del valore di 8 euro/giorno aggiungono circa 170 euro/mese di potere d\'acquisto netto. Per l\'abitazione, un affitto fino a 500 euro è sostenibile e compatibile con il risparmio: fattibile in molte città del Centro-Sud e nelle periferie del Nord.',
  },
  1600: {
    jobs: 'Con 1.600 euro netti mensili (RAL circa ' + fmtCurRound(ralDefault) + ' euro) si collocano profili come analisti dati, programmatori con 2-3 anni di esperienza, specialisti HR, geometri e periti con incarichi di coordinamento, infermieri con anzianità nel pubblico, e impiegati direttivi nel CCNL Commercio (livello 2). Nel Metalmeccanico siamo al livello D1. È anche la retribuzione di giornalisti con contratto FNSI nei primi anni, project manager junior in agenzie di comunicazione, e tecnici di radiologia con esperienza.',
    finance: 'A 1.600 euro netti al mese, le opportunità di pianificazione finanziaria si ampliano sensibilmente. La quota risparmiabile (320 euro/mese applicando la regola del 20%) consente di combinare risparmio precauzionale e investimento: 150 euro/mese in fondo emergenza fino a raggiungere ' + fmtCurRound(1600 * 6) + ' euro (6 mensilità), poi ribilanciare verso un PAC diversificato. La RAL di circa ' + fmtCurRound(ralDefault) + ' euro si trova nella fascia dove il cuneo fiscale inizia a ridursi: verificare che la detrazione sia ancora applicata e nella misura corretta. La differenza tra le addizionali regionali assume un peso rilevante: trasferirsi dal Lazio al Friuli-Venezia Giulia può significare un risparmio di 300-400 euro/anno. Considerare l\'apertura di un fondo pensione complementare: con l\'aliquota marginale al 33%, ogni 1.000 euro versati generano un risparmio fiscale di circa 330 euro.',
  },
  1700: {
    jobs: 'Un netto di 1.700 euro mensili (RAL circa ' + fmtCurRound(ralDefault) + ' euro) è tipico di sviluppatori software con 3-5 anni di esperienza, commercialisti collaboratori di studio, ingegneri junior in aziende industriali, assistenti sociali nel pubblico impiego con anzianità, e responsabili di punto vendita nella GDO. Nel settore bancario corrisponde al 2° livello con scatti di anzianità. È anche la retribuzione di farmacisti collaboratori, archivisti e bibliotecari con contratto pubblico a tempo pieno, e account manager in aziende di medie dimensioni.',
    finance: 'Con 1.700 euro netti al mese, il bilancio personale può sostenere un affitto autonomo anche nelle città del Nord (fino a 550-600 euro restando sotto il 35% del netto) e mantenere un margine di risparmio concreto. L\'allocazione ottimale prevede: 850 euro per spese necessarie, 340 euro per spese discrezionali, 340 euro per risparmio. A questo livello il versamento al fondo pensione complementare diventa particolarmente efficiente: la RAL superiore ai 28.000 euro implica un\'aliquota marginale del 33%, il che significa che ogni euro versato al fondo pensione "costa" effettivamente solo 67 centesimi. Il risparmio fiscale massimo (versando 5.164 euro/anno) è di circa 1.700 euro. Valutare anche le detrazioni per interessi passivi sul mutuo (fino a 760 euro/anno) se si acquista la prima casa.',
  },
  1800: {
    jobs: 'Con 1.800 euro netti al mese (RAL circa ' + fmtCurRound(ralDefault) + ' euro) troviamo ingegneri con 3-5 anni di esperienza, sviluppatori full-stack mid-level, analisti finanziari junior in banca, quadri intermedi nel settore manifatturiero, coordinatori infermieristici, e insegnanti di scuola secondaria con oltre 20 anni di servizio. Nel CCNL Metalmeccanico corrisponde al livello D2, nel settore bancario al 1° livello. È anche lo stipendio di farmacisti con esperienza, geometri con ruolo di capo cantiere, e specialisti di digital marketing con 4-6 anni nel settore.',
    finance: 'A 1.800 euro netti mensili, il potere d\'acquisto consente una vita autonoma confortevole in tutte le città italiane, con capacità di risparmio strutturata. Con una RAL di circa ' + fmtCurRound(ralDefault) + ' euro, si è nella piena operatività del secondo scaglione IRPEF (33%). L\'allocazione strategica del risparmio (360 euro/mese) dovrebbe prevedere: fondo emergenza (se non ancora completato a ' + fmtCurRound(1800 * 6) + ' euro), versamento al fondo pensione (almeno il contributo minimo per attivare il match del datore di lavoro), e PAC su un portafoglio diversificato (60% azionario, 40% obbligazionario). A questo livello di reddito, un mutuo sostenibile (rata massima 30% del netto, ovvero 540 euro) consente di finanziare un immobile di circa 150.000-170.000 euro con un anticipo del 20%.',
  },
  2000: {
    jobs: 'Uno stipendio netto di 2.000 euro al mese (RAL circa ' + fmtCurRound(ralDefault) + ' euro) è la retribuzione di sviluppatori software senior, ingegneri meccanici ed elettronici con esperienza, commercialisti con proprio portafoglio clienti in studio, quadri aziendali in PMI, responsabili risorse umane in aziende di medie dimensioni, e analisti di gestione in banca. Nel settore IT è il livello dei DevOps engineer e dei product owner con 5-7 anni di esperienza. È anche lo stipendio di medici ospedalieri nei primi anni di specializzazione (post-formazione), controller di gestione senior, e project manager certificati nell\'edilizia e nell\'impiantistica.',
    finance: 'Con 2.000 euro netti al mese si entra nella fascia di reddito che consente una pianificazione finanziaria articolata. Il risparmio del 20% (400 euro/mese) può essere suddiviso tra: fondo pensione complementare (massimizzare la deducibilità fino a 5.164 euro/anno con aliquota marginale al 33%), investimenti in ETF tramite PAC (200 euro/mese su un portafoglio globale), e accumulo per obiettivi specifici (anticipo immobiliare, formazione). La rata massima sostenibile per un mutuo è di circa 600 euro, compatibile con un finanziamento di 180.000-200.000 euro a 25 anni. A questo livello, la scelta della regione di residenza incide concretamente: la differenza tra le addizionali più basse e più alte vale circa 500-700 euro/anno.',
  },
  2200: {
    jobs: 'Un netto di 2.200 euro al mese (RAL circa ' + fmtCurRound(ralDefault) + ' euro) è la retribuzione di team leader nel settore IT, ingegneri senior nell\'industria, responsabili commerciali con gestione di area, quadri nel CCNL Metalmeccanico (livello D3-E), avvocati con 5-8 anni di esperienza in studi strutturati, e funzionari pubblici di fascia alta con responsabilità di coordinamento. È anche lo stipendio di medici ospedalieri con qualche anno di servizio, farmacisti direttori di filiale, e consulenti aziendali con portafoglio clienti consolidato.',
    finance: 'Con 2.200 euro netti al mese il margine per costruire ricchezza nel tempo diventa significativo. Allocando 440 euro/mese al risparmio e all\'investimento, in 15 anni con un rendimento medio del 7% si può accumulare un capitale di circa 110.000 euro. Le priorità finanziarie a questo livello sono: massimizzare il versamento al fondo pensione (con aliquota marginale al 33% il beneficio fiscale è elevato), diversificare gli investimenti tra azionario globale ed obbligazionario, e pianificare l\'acquisto della prima casa se non ancora effettuato. Un mutuo con rata di 660 euro (30% del netto) consente di acquistare un immobile fino a 200.000-230.000 euro nelle città del Nord o un appartamento più ampio nel Centro-Sud. Il TFR accantonato annualmente (circa ' + fmtCurRound(ralDefault / 13.5) + ' euro) può essere destinato al fondo pensione con ulteriore vantaggio fiscale.',
  },
  2500: {
    jobs: 'Con 2.500 euro netti al mese (RAL circa ' + fmtCurRound(ralDefault) + ' euro) troviamo profili come engineering manager, solution architect nel settore IT, responsabili di produzione industriale, dirigenti di PMI, medici specialisti a inizio carriera, notai praticanti in studi avviati, e commercialisti con studio autonomo consolidato. Nel settore bancario corrisponde a responsabili di filiale o vice-direttori. È anche la retribuzione di dirigenti scolastici nei primi anni, project manager senior nel settore delle costruzioni, e head of marketing in aziende di medie dimensioni.',
    finance: 'A 2.500 euro netti al mese la strategia finanziaria può diventare sofisticata. La quota risparmiabile (500 euro/mese) consente di articolare il portafoglio su più asset class. Una allocazione suggerita: 200 euro/mese nel fondo pensione (massimizzando il beneficio fiscale), 250 euro/mese in un PAC su ETF diversificato, e 50 euro/mese in liquidità ad alto rendimento per opportunità tattiche. Con una RAL di circa ' + fmtCurRound(ralDefault) + ' euro, l\'aliquota marginale IRPEF è al 33%, il che rende il fondo pensione molto vantaggioso: versando il massimo deducibile di 5.164 euro/anno si risparmiano circa 1.700 euro di tasse. La capacità di mutuo a questo reddito (rata sostenibile di 750 euro) consente l\'acquisto di immobili fino a 250.000-280.000 euro. Valutare anche polizze vita detraibili (fino a 530 euro/anno di detrazione) e investimenti in PIR per l\'esenzione fiscale sui capital gain.',
  },
  2800: {
    jobs: 'Un netto di 2.800 euro al mese (RAL circa ' + fmtCurRound(ralDefault) + ' euro) corrisponde a ruoli di senior management: direttori di funzione in aziende medio-grandi, principal consultant in società di consulenza, lead developer e CTO di startup in crescita, medici ospedalieri con specializzazione e anzianità, e dirigenti nel settore assicurativo. Nel settore pubblico, è lo stipendio di dirigenti di seconda fascia con incarichi di responsabilità. È anche la retribuzione di avvocati senior in studi legali internazionali, responsabili di area in società di revisione (Big Four), e country manager di aziende estere in Italia.',
    finance: 'Con 2.800 euro netti al mese le necessità di base sono ampiamente coperte e la pianificazione finanziaria può focalizzarsi sulla crescita patrimoniale. Il risparmio del 25-30% (700-840 euro/mese) permette di costruire un portafoglio diversificato: fondo pensione al massimo deducibile (5.164 euro/anno), PAC su ETF globali (300-400 euro/mese), ed eventualmente investimenti immobiliari tramite crowdfunding o REITs. Con una RAL di circa ' + fmtCurRound(ralDefault) + ' euro, parte del reddito ricade nello scaglione IRPEF al 43%: la deduzione per il fondo pensione genera un risparmio fiscale fino a 2.200 euro/anno. La capacità di mutuo (rata sostenibile di 840 euro) consente di finanziare immobili di valore elevato. A questo livello patrimoniale, è consigliabile un confronto con un consulente finanziario indipendente per ottimizzare l\'asset allocation e la pianificazione successoria.',
  },
  3000: {
    jobs: 'Uno stipendio netto di 3.000 euro al mese (RAL circa ' + fmtCurRound(ralDefault) + ' euro) è tipico di posizioni dirigenziali in aziende strutturate: direttori commerciali, VP Engineering nel tech, partner junior in studi professionali, medici primari ospedalieri, e dirigenti industriali con responsabilità di P&L. Nel settore finanziario corrisponde a portfolio manager, responsabili di desk di trading, e direttori di rete bancaria. È anche la retribuzione di docenti universitari di seconda fascia, magistrati con anzianità, e general manager di filiali italiane di multinazionali di medie dimensioni.',
    finance: 'Con 3.000 euro netti al mese la gestione finanziaria richiede una strategia strutturata. La RAL di circa ' + fmtCurRound(ralDefault) + ' euro comporta un\'aliquota marginale del 43%, il che rende essenziale l\'ottimizzazione fiscale. priorità: massimizzare il fondo pensione (risparmio fiscale di oltre 2.200 euro/anno), valutare il welfare aziendale come componente della retribuzione (fringe benefit, auto aziendale, assicurazione sanitaria integrativa). Con un risparmio di 900 euro/mese (30% del netto), in 15 anni si può accumulare un capitale di oltre 250.000 euro. Il patrimonio va diversificato: 40-50% azionario globale, 20-30% obbligazionario, 10-20% immobiliare. Valutare un consulente finanziario indipendente (fee-only) per la pianificazione previdenziale: l\'aliquota marginale alta rende il fondo pensione e i fondi sanitari integrativi particolarmente vantaggiosi.',
  },
  3500: {
    jobs: 'Con 3.500 euro netti al mese (RAL circa ' + fmtCurRound(ralDefault) + ' euro) siamo nell\'ambito dell\'alta dirigenza: C-level (CFO, COO, CTO) di aziende medio-grandi, partner di studi legali e di consulenza, medici primari con incarichi direttivi, dirigenti di prima fascia nel settore pubblico, e country director di multinazionali. Nel settore tech, corrisponde a VP o SVP in scale-up e grandi aziende. È anche la retribuzione di docenti universitari ordinari con anzianità, dirigenti bancari di alto livello, e managing director di società di revisione.',
