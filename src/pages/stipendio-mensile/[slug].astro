const nettoProfile = nettoProfiles[nettoTarget];

// FAQs
function buildFaqs() {
  type FAQ = { question: string; answer: string };

  // 3 base FAQs (always present, adapted per amount)
  const baseFaqs: FAQ[] = [
    {
      question: `Quanto lordo serve per guadagnare ${fmtCurRound(nettoTarget)} euro netti al mese?`,
      answer: `Per ottenere circa ${fmtCurRound(nettoTarget)} euro netti al mese servono circa ${fmtCurRound(ralDefault)} euro di RAL (Retribuzione Annua Lorda), considerando 13 mensilità, contratto a tempo indeterminato in Lombardia, senza carichi familiari. L'aliquota media effettiva risulta del ${fmtPct(dettaglio.aliquotaMedia)}, con un costo azienda complessivo di circa ${fmtCurRound(dettaglio.costoAzienda)} euro.`,
    },
    {
      question: `${fmtCurRound(nettoTarget)} euro netti al mese sono un buon stipendio in Italia?`,
      answer: `Uno stipendio di ${fmtCurRound(nettoTarget)} euro netti al mese si colloca a un livello ${market.livello} rispetto alla media nazionale. ${market.contesto} Lo stipendio mediano in Italia e di circa 1.400 euro netti mensili (dati ISTAT). I settori tipici per questa fascia retributiva sono: ${market.settori}.`,
    },
    {
      question: `Come viene calcolato lo stipendio netto partendo da ${fmtCurRound(ralDefault)} euro di RAL?`,
      answer: `Dalla RAL di ${fmtCurRound(ralDefault)} euro si sottraggono i contributi INPS (${fmtCur(dettaglio.contributiINPS)} euro, pari al 9,19%), ottenendo un imponibile fiscale di ${fmtCur(dettaglio.imponibileFiscale)} euro. Su questo si applica l'IRPEF per scaglioni (${fmtCur(dettaglio.irpefLorda)} euro di IRPEF lorda), poi si aggiungono le detrazioni per lavoro dipendente (${fmtCur(dettaglio.detrazioneLavoroDipendente)} euro)${dettaglio.cuneoFiscaleDetrazione > 0 ? ` e il cuneo fiscale (${fmtCur(dettaglio.cuneoFiscaleDetrazione)} euro)` : ''}. Infine si sottraggono le addizionali regionali e comunali, arrivando a un netto annuo di ${fmtCur(dettaglio.nettoAnnuo)} euro, ovvero ${fmtCur(dettaglio.nettoMensile)} euro al mese su 13 mensilita.`,
    },
  ];

  // Additional FAQs based on salary range
  const rangeFaqs: FAQ[] = [];

  if (nettoTarget <= 1200) {
    // Entry-level
    rangeFaqs.push({
      question: `Con ${fmtCurRound(nettoTarget)} euro netti al mese ho diritto al trattamento integrativo?`,
      answer: `Si. Con una RAL di circa ${fmtCurRound(ralDefault)} euro, il reddito complessivo rientra ampiamente nella soglia dei 15.000 euro prevista per il trattamento integrativo pieno di 1.200 euro/anno (100 euro/mese). Questo importo e gia incluso nel calcolo del netto mensile. Tra 15.000 e 28.000 euro di reddito il trattamento spetta solo se le detrazioni superano l'imposta lorda.`,
    });
    rangeFaqs.push({
      question: `Quali agevolazioni ISEE posso ottenere con uno stipendio di ${fmtCurRound(nettoTarget)} euro netti?`,
      answer: `Con un reddito corrispondente a circa ${fmtCurRound(ralDefault)} euro di RAL, l'ISEE risultera generalmente basso (dipende anche dal patrimonio e dalla composizione del nucleo familiare). Questo puo dare accesso a: bonus bollette per luce, gas e acqua (ISEE sotto 9.530 euro o 20.000 euro per famiglie numerose), riduzione della TARI, esenzione dal ticket sanitario, assegno unico maggiorato, e agevolazioni per il trasporto pubblico locale. Si consiglia di richiedere l'ISEE aggiornato tramite CAF o sito INPS.`,
    });
    rangeFaqs.push({
      question: `E possibile vivere da soli con ${fmtCurRound(nettoTarget)} euro al mese?`,
      answer: `Vivere in autonomia con ${fmtCurRound(nettoTarget)} euro netti al mese e molto difficile nelle grandi citta del Nord, dove i soli affitti superano spesso i 500-600 euro. E piu fattibile in citta medio-piccole del Centro-Sud dove gli affitti partono da 250-350 euro, oppure in condivisione. La regola del 30% suggerirebbe un affitto massimo di circa ${fmtCurRound(nettoTarget * 0.3)} euro, lasciando ${fmtCurRound(nettoTarget * 0.7)} euro per tutte le altre spese.`,
    });
  } else if (nettoTarget <= 1500) {
    // Lower-middle
    rangeFaqs.push({
      question: `Lo stipendio di ${fmtCurRound(nettoTarget)} euro netti e sopra o sotto la mediana italiana?`,
      answer: `Uno stipendio di ${fmtCurRound(nettoTarget)} euro netti al mese si colloca ${nettoTarget >= 1400 ? 'in linea con o leggermente sopra' : 'leggermente sotto'} la mediana nazionale dei lavoratori dipendenti, che secondo i dati ISTAT e di circa 1.400 euro netti mensili. Questo significa che circa ${nettoTarget >= 1400 ? 'la meta' : 'piu della meta'} dei lavoratori dipendenti in Italia percepisce un netto mensile ${nettoTarget >= 1400 ? 'inferiore' : 'superiore'} a questo importo. Il dato va contestualizzato: la mediana varia significativamente tra Nord (circa 1.600 euro) e Sud (circa 1.200 euro).`,
    });
    rangeFaqs.push({
      question: `Quanto incide il cuneo fiscale su una RAL di ${fmtCurRound(ralDefault)} euro?`,
      answer: `Con una RAL di ${fmtCurRound(ralDefault)} euro, il cuneo fiscale ha un impatto significativo sul netto. I contributi INPS a carico del lavoratore ammontano a ${fmtCur(dettaglio.contributiINPS)} euro, l'IRPEF netta a ${fmtCur(dettaglio.irpefNetta)} euro, le addizionali a ${fmtCur(dettaglio.addizionaleRegionale + dettaglio.addizionaleComunale)} euro. Le detrazioni per lavoro dipendente (${fmtCur(dettaglio.detrazioneLavoroDipendente)} euro)${dettaglio.trattamentoIntegrativo > 0 ? ` e il trattamento integrativo (${fmtCur(dettaglio.trattamentoIntegrativo)} euro)` : ''} attenuano il prelievo. L'aliquota media complessiva e del ${fmtPct(dettaglio.aliquotaMedia)}.`,
    });
    rangeFaqs.push({
      question: `Con 14 mensilita il netto mensile di ${fmtCurRound(nettoTarget)} euro cambia?`,
      answer: `Con 14 mensilita la RAL rimane di ${fmtCurRound(ralDefault)} euro, ma il netto annuo di ${fmtCur(dettaglio.nettoAnnuo)} euro viene diviso per 14 anziche 13. Il netto per singola mensilita scenderebbe a circa ${fmtCurRound(dettaglio.nettoAnnuo / 14)} euro (circa il 7% in meno rispetto ai ${fmtCur(dettaglio.nettoMensile)} euro su 13 mensilita), compensato dalle due mensilita aggiuntive (tredicesima e quattordicesima). Il netto annuo totale resta sostanzialmente invariato.`,
    });
  } else if (nettoTarget <= 1800) {
    // Middle
    rangeFaqs.push({
      question: `Conviene versare al fondo pensione con una RAL di ${fmtCurRound(ralDefault)} euro?`,
      answer: `Si, e molto conveniente. Con una RAL di ${fmtCurRound(ralDefault)} euro l'aliquota marginale IRPEF e del ${fmtPct(dettaglio.aliquotaMarginale)}: ogni euro versato al fondo pensione complementare genera un risparmio fiscale pari a quell'aliquota. Versando il massimo deducibile di 5.164 euro/anno si risparmiano circa ${fmtCurRound(5164 * dettaglio.aliquotaMarginale)} euro di IRPEF. In piu, il TFR annuo (circa ${fmtCur(dettaglio.tfrAnnuo)} euro) puo essere destinato al fondo pensione con tassazione agevolata in fase di erogazione (aliquota dal 15% al 9% in base agli anni di iscrizione).`,
    });
    rangeFaqs.push({
      question: `In quale scaglione IRPEF ricade una RAL di ${fmtCurRound(ralDefault)} euro?`,
      answer: `Con una RAL di ${fmtCurRound(ralDefault)} euro, dopo la deduzione dei contributi INPS (${fmtCur(dettaglio.contributiINPS)} euro), l'imponibile fiscale e di circa ${fmtCur(dettaglio.imponibileFiscale)} euro. Questo reddito ricade ${dettaglio.imponibileFiscale <= 28000 ? 'interamente nel primo scaglione IRPEF al 23% (fino a 28.000 euro)' : dettaglio.imponibileFiscale <= 50000 ? 'nei primi due scaglioni IRPEF: 23% fino a 28.000 euro e 33% sull\'eccedenza fino a 50.000 euro' : 'in tre scaglioni IRPEF: 23% fino a 28.000 euro, 33% da 28.000 a 50.000 euro, e 43% oltre i 50.000 euro'}. L'aliquota marginale effettiva e del ${fmtPct(dettaglio.aliquotaMarginale)}, mentre quella media e del ${fmtPct(dettaglio.aliquotaMedia)}.`,
    });
    rangeFaqs.push({
      question: `Con 14 mensilita il netto mensile di ${fmtCurRound(nettoTarget)} euro cambia?`,
      answer: `Con 14 mensilita la RAL rimane di ${fmtCurRound(ralDefault)} euro, ma il netto annuo di ${fmtCur(dettaglio.nettoAnnuo)} euro viene diviso per 14 anziche 13. Il netto per singola mensilita scenderebbe a circa ${fmtCurRound(dettaglio.nettoAnnuo / 14)} euro (circa il 7% in meno rispetto ai ${fmtCur(dettaglio.nettoMensile)} euro su 13 mensilita), compensato dalle due mensilita aggiuntive. Il netto annuo totale resta invariato.`,
    });
  } else if (nettoTarget <= 2200) {
    // Upper-middle
    rangeFaqs.push({
      question: `Quanto posso risparmiare sulle tasse scegliendo la regione giusta con ${fmtCurRound(nettoTarget)} euro netti?`,
      answer: `Con una RAL di circa ${fmtCurRound(ralDefault)} euro, la differenza tra le addizionali regionali puo incidere per ${fmtCurRound((regionResults[regionResults.length - 1].ral - regionResults[0].ral))} euro di RAL necessaria in piu tra la regione piu conveniente (${regionResults[0].nome}, RAL ${fmtCurRound(regionResults[0].ral)} euro) e quella piu costosa (${regionResults[regionResults.length - 1].nome}, RAL ${fmtCurRound(regionResults[regionResults.length - 1].ral)} euro). In termini di addizionale regionale, la differenza annua e di circa ${fmtCurRound(regionResults[regionResults.length - 1].addizionaleRegionale - regionResults[0].addizionaleRegionale)} euro. Per chi ha flessibilita sulla residenza, e un fattore da considerare nella pianificazione fiscale.`,
    });
    rangeFaqs.push({
      question: `Che mutuo posso permettermi con ${fmtCurRound(nettoTarget)} euro netti al mese?`,
      answer: `Con un netto mensile di circa ${fmtCur(dettaglio.nettoMensile)} euro, applicando la regola bancaria del 30-35% del reddito netto per la rata del mutuo, la rata massima sostenibile e di circa ${fmtCurRound(dettaglio.nettoMensile * 0.3)}-${fmtCurRound(dettaglio.nettoMensile * 0.35)} euro. Con un mutuo a 25 anni al tasso attuale (circa 3-3,5%), questo consente di finanziare un immobile del valore di circa ${fmtCurRound(dettaglio.nettoMensile * 0.3 * 200)}-${fmtCurRound(dettaglio.nettoMensile * 0.35 * 200)} euro (con un anticipo del 20%). Ricordate che gli interessi passivi sul mutuo prima casa sono detraibili al 19% fino a un massimo di 4.000 euro/anno (risparmio fino a 760 euro/anno).`,
    });
    rangeFaqs.push({
      question: `Conviene il fondo pensione con un'aliquota marginale del ${fmtPct(dettaglio.aliquotaMarginale)}?`,
      answer: `Assolutamente si. Con una RAL di ${fmtCurRound(ralDefault)} euro e un'aliquota marginale del ${fmtPct(dettaglio.aliquotaMarginale)}, il fondo pensione complementare offre un doppio vantaggio: ogni euro versato (fino a 5.164 euro/anno) riduce l'IRPEF di ${fmtPct(dettaglio.aliquotaMarginale)}, e in fase di erogazione la tassazione sara agevolata (dal 15% al 9%). Il risparmio fiscale massimo annuo e di circa ${fmtCurRound(5164 * dettaglio.aliquotaMarginale)} euro. Il TFR annuo accantonato (${fmtCur(dettaglio.tfrAnnuo)} euro) puo essere conferito al fondo pensione per massimizzare il montante previdenziale.`,
    });
  } else if (nettoTarget <= 3000) {
    // High
    rangeFaqs.push({
      question: `Quanto pago di IRPEF al 43% con una RAL di ${fmtCurRound(ralDefault)} euro?`,
      answer: `Con una RAL di ${fmtCurRound(ralDefault)} euro, l'imponibile fiscale e di circa ${fmtCur(dettaglio.imponibileFiscale)} euro. ${dettaglio.imponibileFiscale > 50000 ? `La quota tassata al 43% (lo scaglione piu alto) e di ${fmtCur(dettaglio.imponibileFiscale - 50000)} euro, su cui si pagano ${fmtCur((dettaglio.imponibileFiscale - 50000) * 0.43)} euro di IRPEF. Complessivamente, l'IRPEF lorda totale e di ${fmtCur(dettaglio.irpefLorda)} euro.` : `L'imponibile non supera ancora la soglia dei 50.000 euro per lo scaglione al 43%, quindi l'aliquota marginale e del 33%. L'IRPEF lorda totale e di ${fmtCur(dettaglio.irpefLorda)} euro.`} L'aliquota media effettiva risulta del ${fmtPct(dettaglio.aliquotaMedia)}.`,
    });
    rangeFaqs.push({
      question: `Quali strategie di ottimizzazione fiscale con ${fmtCurRound(nettoTarget)} euro netti al mese?`,
      answer: `Con una RAL di ${fmtCurRound(ralDefault)} euro e un'aliquota marginale del ${fmtPct(dettaglio.aliquotaMarginale)}, le principali leve di ottimizzazione sono: 1) Fondo pensione complementare (risparmio fino a ${fmtCurRound(5164 * dettaglio.aliquotaMarginale)} euro/anno); 2) Welfare aziendale (fringe benefit, buoni pasto, assicurazione sanitaria integrativa sono detassati); 3) Detrazioni per interessi passivi mutuo prima casa (fino a 760 euro/anno); 4) Versamenti a fondi sanitari integrativi (deducibili fino a 3.615 euro/anno); 5) PIR (Piani Individuali di Risparmio) per l'esenzione fiscale sui capital gain fino a 150.000 euro investiti.`,
    });
    rangeFaqs.push({
      question: `Come cambia il netto con 14 mensilita a questo livello di RAL?`,
      answer: `Con 14 mensilita e una RAL invariata di ${fmtCurRound(ralDefault)} euro, il netto annuo di ${fmtCur(dettaglio.nettoAnnuo)} euro viene suddiviso in 14 rate anziche 13. Ogni mensilita sara di circa ${fmtCurRound(dettaglio.nettoAnnuo / 14)} euro (invece di ${fmtCur(dettaglio.nettoMensile)} euro), ma si ricevono due mensilita aggiuntive. Per redditi di questa fascia, le 14 mensilita possono avere un leggero vantaggio fiscale nella gestione dei conguagli di fine anno.`,
    });
  } else {
    // Very high (> 3000)
    rangeFaqs.push({
      question: `Il regime degli impatriati si applica anche con ${fmtCurRound(nettoTarget)} euro netti al mese?`,
      answer: `Si. Il regime fiscale per lavoratori impatriati (art. 16 D.Lgs. 147/2015, aggiornato dal D.Lgs. 209/2023) prevede una tassazione ridotta al 50% del reddito per chi trasferisce la residenza fiscale in Italia dopo almeno 2 anni all'estero (requisiti specifici dal 2024). Con una RAL di ${fmtCurRound(ralDefault)} euro, il risparmio fiscale puo superare i ${fmtCurRound(dettaglio.irpefNetta * 0.4)} euro/anno. Il regime dura 5 anni (estendibile in alcuni casi). Si tratta di un'agevolazione molto significativa per redditi di questa fascia, dove l'aliquota marginale e del 43%.`,
    });
    rangeFaqs.push({
      question: `Il massimale contributivo INPS incide su una RAL di ${fmtCurRound(ralDefault)} euro?`,
      answer: `Il massimale contributivo INPS (circa 119.650 euro per il 2025, rivalutato annualmente) si applica solo ai lavoratori iscritti a forme pensionistiche obbligatorie dal 1 gennaio 1996 (sistema contributivo puro). Con una RAL di ${fmtCurRound(ralDefault)} euro, ${ralDefault > 119650 ? `il massimale e superato: i contributi INPS si versano solo sulla quota fino al massimale, con un risparmio contributivo ma anche una pensione futura proporzionalmente ridotta. E fondamentale integrare con previdenza complementare.` : `il massimale non e ancora raggiunto, ma e importante monitorarlo in caso di aumenti retributivi. I contributi INPS ammontano a ${fmtCur(dettaglio.contributiINPS)} euro/anno.`} Per chi e nel sistema retributivo o misto, il massimale non si applica.`,
    });
    rangeFaqs.push({
      question: `Come gestire il patrimonio con uno stipendio netto di ${fmtCurRound(nettoTarget)} euro al mese?`,
      answer: `Con ${fmtCurRound(nettoTarget)} euro netti mensili (RAL di ${fmtCurRound(ralDefault)} euro), la capacita di accumulo e elevata: risparmiando il 25-30% del netto si accantonano circa ${fmtCurRound(nettoTarget * 0.25 * 12)}-${fmtCurRound(nettoTarget * 0.3 * 12)} euro/anno. Le priorita di gestione patrimoniale sono: massimizzare il fondo pensione (risparmio fiscale al 43% di aliquota marginale, circa ${fmtCurRound(5164 * 0.43)} euro/anno); diversificare gli investimenti (ETF globali, obbligazionario, immobiliare tramite REITs); valutare ELTIF per investimenti in private equity con benefici fiscali; pianificare la successione patrimoniale. A questo livello, un consulente finanziario indipendente (fee-only) puo ottimizzare l'asset allocation e la pianificazione fiscale complessiva.`,
    });
    rangeFaqs.push({
      question: `Quanto incidono le addizionali regionali su un reddito cosi elevato?`,
      answer: `Con una RAL di ${fmtCurRound(ralDefault)} euro, le addizionali regionali hanno un impatto molto rilevante in valore assoluto. La differenza tra la regione meno costosa (${regionResults[0].nome}, addizionale di ${fmtCur(regionResults[0].addizionaleRegionale)} euro) e la piu costosa (${regionResults[regionResults.length - 1].nome}, addizionale di ${fmtCur(regionResults[regionResults.length - 1].addizionaleRegionale)} euro) e di circa ${fmtCurRound(regionResults[regionResults.length - 1].addizionaleRegionale - regionResults[0].addizionaleRegionale)} euro/anno. Per i redditi alti, alcune regioni come il Lazio applicano aliquote progressive che penalizzano particolarmente questa fascia.`,
    });
  }

  return [...baseFaqs, ...rangeFaqs];
}

const faqs = buildFaqs();

// SEO
const title = `${fmtCurRound(nettoTarget)} Euro Netti al Mese: Quanta RAL Serve nel 2026?`;
const description = `Per ${fmtCurRound(nettoTarget)} euro netti al mese servono circa ${fmtCurRound(ralDefault)} euro lordi (RAL) su 13 mensilità. Calcolo 2026: IRPEF, INPS 9,19%, detrazioni e confronto netto per regione.`;

const breadcrumbs = [
  { name: 'Home', url: `${SITE.url}/` },
  { name: 'Stipendio Mensile', url: `${SITE.url}/stipendio-mensile/` },
  { name: `${fmtCurRound(nettoTarget)} €`, url: `${SITE.url}/stipendio-mensile/${slug}/` },
];

const schemaString = JSON.stringify([
  breadcrumbSchema(breadcrumbs),
  faqSchema(faqs),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: `${SITE.url}/stipendio-mensile/${slug}/`,
    inLanguage: SITE.locale,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: `${SITE.url}/` },
    dateModified: '2026-01-15',
  },
]);
