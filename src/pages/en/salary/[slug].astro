---
import FAQFisarmonica from '../../../components/ui/FAQFisarmonica.astro';
import Layout from '../../../layouts/Layout.astro';
import { SITE } from '../../../config';
import { calcolaStipendio, type RisultatoStipendio } from '../../../lib/irpef-engine';
import { regioni } from '../../../data/regioni';
import { formatCurrency, formatRate } from '../../../lib/format';
import { breadcrumbSchema, faqSchema } from '../../../lib/seo';

/* ──────────────────────────────────────────────────────────────────────────
   getStaticPaths — generates 24 RAL pages (English)
   ────────────────────────────────────────────────────────────────────────── */

export function getStaticPaths() {
  const ALL_RALS = [
    15_000, 18_000, 20_000, 22_000,
    25_000, 27_000, 28_000, 30_000, 32_000, 35_000, 38_000,
    40_000, 42_000, 45_000, 50_000, 55_000,
    60_000, 65_000, 70_000, 80_000, 90_000, 100_000, 120_000, 150_000,
  ];

  function ralToSlug(ral: number): string {
    return `${ral}-euro-net`;
  }

  function fmtRal(ral: number): string {
    return ral.toLocaleString('en-US');
  }

  function getRangeKey(ral: number): string {
    if (ral <= 22_000) return 'low';
    if (ral <= 32_000) return 'lower-middle';
    if (ral <= 45_000) return 'middle';
    if (ral <= 70_000) return 'upper-middle';
    return 'high';
  }

  function getAdjacentLinks(ral: number) {
    const idx = ALL_RALS.indexOf(ral);
    const indices: number[] = [];
    for (let i = Math.max(0, idx - 3); i < idx; i++) indices.push(i);
    for (let i = idx + 1; i <= Math.min(ALL_RALS.length - 1, idx + 3); i++) indices.push(i);

    const anchors = [
      'Find out how much you earn with',
      'What\'s left net with',
      'Net salary calculation for',
      'See the details of',
      'Monthly net for',
      'Full analysis of',
    ];

    return indices.map((i, j) => ({
      ral: ALL_RALS[i],
      slug: ralToSlug(ALL_RALS[i]),
      anchor: `${anchors[j % anchors.length]} RAL ${fmtRal(ALL_RALS[i])} EUR`,
    }));
  }

  function buildFaqs(
    ral: number,
    result: RisultatoStipendio,
    best: { nome: string; nettoMensile: number },
    worst: { nome: string; nettoMensile: number },
  ) {
    const ralF = fmtRal(ral);
    const nettoF = formatCurrency(result.nettoMensile, 'en');
    const rangeKey = getRangeKey(ral);

    const faqs = [
      {
        question: `How much do you earn net per month with a gross salary (RAL) of ${ralF} euro?`,
        answer: `With a gross salary (RAL) of ${ralF} euro and 13 pay periods, the monthly net salary is approximately ${nettoF} for a single employee residing in Lombardy. The amount varies based on the region of residence, family situation, and municipal tax rate.`,
      },
      {
        question: `Which Italian region has the highest net pay with a RAL of ${ralF} euro?`,
        answer: `With a RAL of ${ralF} euro, the region with the highest monthly net pay is ${best.nome} (${formatCurrency(best.nettoMensile, 'en')}), thanks to lower regional surcharges (addizionale regionale). The least favorable region is ${worst.nome} (${formatCurrency(worst.nettoMensile, 'en')}), with a difference of ${formatCurrency(best.nettoMensile - worst.nettoMensile, 'en')} per month. The gap comes only from regional and municipal surcharges, since national income tax and social contributions are identical across Italy. Before relocating, compare the local cost of living too: it weighs far more than the surcharge itself.`,
      },
      {
        question: `How much tax do you pay on a RAL of ${ralF} euro in Italy?`,
        answer: `On a RAL of ${ralF} euro, the overall effective tax rate is approximately ${formatRate(result.aliquotaMedia, 'en')} (INPS social contributions + IRPEF income tax + regional and municipal surcharges). The marginal IRPEF rate is ${formatRate(result.aliquotaMarginale, 'en')}. The annual net salary is approximately ${formatCurrency(result.nettoAnnuo, 'en')}. The total splits into three separate items: INPS contributions withheld from the employee, national IRPEF charged in brackets, and regional and municipal surcharges that vary by where you live. Employment deductions and the trattamento integrativo are then subtracted, where they apply.`,
      },
    ];

    if (rangeKey === 'low') {
      faqs.push({
        question: `With a RAL of ${ralF} euro, are you entitled to the trattamento integrativo (supplementary benefit)?`,
        answer: `Yes, with a RAL of ${ralF} euro the employee is generally entitled to the trattamento integrativo (formerly "bonus Renzi") of EUR 1,200 per year (EUR 100 per month), which is paid directly through the payslip by the employer. This bonus applies to incomes up to EUR 15,000 and, in reduced form, up to EUR 28,000.`,
      });
      faqs.push({
        question: `How can you verify your payslip is correct with a RAL of ${ralF} euro?`,
        answer: `Check that the INPS taxable base matches the RAL, that social contributions are calculated at 9.19%, that the trattamento integrativo is applied, and that the employment income deduction (detrazione lavoro dipendente) is present. With low salaries, errors are more frequent and their percentage impact is greater.`,
      });
    } else if (rangeKey === 'lower-middle') {
      faqs.push({
        question: `With a RAL of ${ralF} euro, how does the cuneo fiscale (tax wedge) work?`,
        answer: `With a RAL of ${ralF} euro, the cuneo fiscale 2026 provides a EUR 1,000/year additional deduction (about EUR 77 extra net monthly). At your marginal rate of ${formatRate(result.aliquotaMarginale, 'en')}, net monthly pay reaches ${formatCurrency(result.nettoMensile, 'en')}. ${ral >= 30_000 ? 'Note: above EUR 32,000 this deduction gradually decreases, reaching zero at EUR 40,000.' : 'At this income level you receive the full deduction, which only starts decreasing above EUR 32,000.'}`,
      });
    } else if (rangeKey === 'middle') {
      faqs.push({
        question: `Is a pension fund (fondo pensione) worth it with a RAL of ${ralF} euro?`,
        answer: `Yes, with a RAL of ${ralF} euro, contributions to a complementary pension fund are tax-deductible up to EUR 5,164.57 per year. With a marginal rate of ${formatRate(result.aliquotaMarginale, 'en')}, every EUR 1,000 contributed reduces your taxes by approximately ${formatCurrency(1000 * result.aliquotaMarginale, 'en')}. This is one of the most effective tax optimization strategies at this income level.`,
      });
      faqs.push({
        question: `Which IRPEF tax bracket does a RAL of ${ralF} euro fall into?`,
        answer: `With a RAL of ${ralF} euro, after deducting INPS contributions, the taxable income falls mainly in the second IRPEF bracket (23% up to EUR 28,000 and 33% from EUR 28,001 to EUR 50,000). The effective marginal rate is ${formatRate(result.aliquotaMarginale, 'en')}. Remember that a bracket rate applies only to the portion of income inside it, never to the whole income, which is the most common misunderstanding about Italian tax. Taxable income is also lower than the RAL itself, because social contributions are deducted first.`,
      });
    } else if (rangeKey === 'upper-middle') {
      faqs.push({
        question: `With a RAL of ${ralF} euro, do you pay 43% in taxes?`,
        answer: `Not on the entire salary. With a RAL of ${ralF} euro, the 43% rate only applies to the portion of taxable income exceeding EUR 50,000. The first brackets are taxed at 23% and 33%. The effective average rate is ${formatRate(result.aliquotaMedia, 'en')}, significantly lower than 43%.`,
      });
    } else {
      faqs.push({
        question: `How does the regime impatriati (expatriate tax regime) work with a RAL of ${ralF} euro?`,
        answer: `The regime impatriati provides a 50% exemption on taxable income for workers who transfer their tax residence to Italy. With a RAL of ${ralF} euro, the annual tax savings can exceed ${formatCurrency(ral * 0.15, 'en')} thanks to the reduced taxation. The regime is available for 5 years, extendable in certain cases.`,
      });
      faqs.push({
        question: `Is there an INPS contribution ceiling for a RAL of ${ralF} euro?`,
        answer: `Yes, for 2026 the INPS contribution ceiling (massimale contributivo) is approximately EUR 119,650. Beyond this threshold, no further INPS employee contributions are due. With a RAL of ${ralF} euro, ${ral > 119_650 ? 'the exceeding portion is not subject to INPS employee contributions' : 'the entire RAL is subject to INPS contributions'}. The ceiling applies only to workers who started contributing after 1996 and is set each year by INPS: above that threshold no further pension contributions are due. Below it, the rate applies to the whole taxable base.`,
      });
    }

    return faqs;
  }

  return ALL_RALS.map((ral) => {
    const slug = ralToSlug(ral);
    const ralFormatted = fmtRal(ral);

    const defaultResult = calcolaStipendio({ ral, regione: 'LOM', mensilita: 13 });

    const regionResults = regioni.map((r) => {
      const res = calcolaStipendio({ ral, regione: r.codice, mensilita: 13 });
      return {
        nome: r.nome,
        codice: r.codice,
        nettoMensile: res.nettoMensile,
        addizionaleRegionale: res.addizionaleRegionale,
        differenza: 0,
      };
    });

    regionResults.sort((a, b) => b.nettoMensile - a.nettoMensile);

    const bestRegion = regionResults[0];
    const worstRegion = regionResults[regionResults.length - 1];

    const regionRows = regionResults.map((r) => ({
      ...r,
      differenza: r.nettoMensile - bestRegion.nettoMensile,
    }));

    const familySituations = [
      { label: 'Single', opts: {} },
      { label: 'With dependent spouse', opts: { coniugeACarico: true } },
      { label: 'With 1 child (21+)', opts: { figliACarico21plus: 1 } },
      { label: 'With 2 children (21+)', opts: { figliACarico21plus: 2 } },
      { label: 'With spouse + 1 child', opts: { coniugeACarico: true, figliACarico21plus: 1 } },
    ];

    const singleNetto = defaultResult.nettoMensile;

    const familyRows = familySituations.map((sit) => {
      const res = calcolaStipendio({ ral, regione: 'LOM', mensilita: 13, ...sit.opts });
      return {
        label: sit.label,
        nettoMensile: res.nettoMensile,
        differenza: res.nettoMensile - singleNetto,
      };
    });

    const rangeKey = getRangeKey(ral);
    const adjacentLinks = getAdjacentLinks(ral);
    const faqs = buildFaqs(ral, defaultResult, bestRegion, worstRegion);

    const nettoPreview = formatCurrency(defaultResult.nettoMensile, 'en');
    const seoTitle = `€${ralFormatted} Gross Salary Italy: Monthly Net Take-Home Pay ${SITE.annoFiscale}`;
    const seoDescription = `With a €${ralFormatted} gross salary (RAL) in Italy you take home about ${nettoPreview} net per month over 13 pay periods. Full IRPEF, INPS, and regional tax breakdown.`;

    return {
      params: { slug },
      props: {
        ral,
        ralFormatted,
        defaultResult,
        regionRows,
        bestRegion,
        worstRegion,
        familyRows,
        faqs,
        adjacentLinks,
        rangeKey,
        seoTitle,
        seoDescription,
      },
    };
  });
}

/* ──────────────────────────────────────────────────────────────────────────
   Page rendering
   ────────────────────────────────────────────────────────────────────────── */

interface RegionRow {
  nome: string;
  codice: string;
  nettoMensile: number;
  addizionaleRegionale: number;
  differenza: number;
}

interface FamilyRow {
  label: string;
  nettoMensile: number;
  differenza: number;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface AdjacentLink {
  ral: number;
  slug: string;
  anchor: string;
}

const {
  ral,
  ralFormatted,
  defaultResult,
  regionRows,
  bestRegion,
  worstRegion,
  familyRows,
  faqs,
  adjacentLinks,
  rangeKey,
  seoTitle,
  seoDescription,
} = Astro.props as {
  ral: number;
  ralFormatted: string;
  defaultResult: RisultatoStipendio;
  regionRows: RegionRow[];
  bestRegion: RegionRow;
  worstRegion: RegionRow;
  familyRows: FamilyRow[];
  faqs: FaqItem[];
  adjacentLinks: AdjacentLink[];
  rangeKey: string;
  seoTitle: string;
  seoDescription: string;
};

const { slug } = Astro.params;

const breadcrumbs = [
  { name: 'Home', url: `${SITE.url}/en/` },
  { name: 'Salary', url: `${SITE.url}/en/salary/` },
  { name: `RAL ${ralFormatted} EUR`, url: `${SITE.url}/en/salary/${slug}/` },
];

const schemas = [
  breadcrumbSchema(breadcrumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: seoTitle,
    description: seoDescription,
    url: `${SITE.url}/en/salary/${slug}/`,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: `${SITE.url}/en/` },
  },
  faqSchema(faqs),
];

const schemaString = JSON.stringify(schemas);

/* ── Narrative content by range ─────────────────────────────────────────── */

function formatRalLabel(ral: number): string {
  return ral.toLocaleString('en-US');
}

const ralNarratives: Record<number, { analysisTitle: string; analysisBody: string; goodSalaryTitle: string; goodSalaryBody: string }> = {
  15_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(15_000, 'en')} Gross Salary`,
    analysisBody: `<p>A gross annual salary (RAL) of ${formatCurrency(15_000, 'en')} places you squarely within the first IRPEF bracket, where all taxable income is taxed at the flat 23% rate. After deducting INPS employee contributions at 9.19%, your fiscal taxable income (imponibile fiscale) comes to approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')}. Because this amount falls well below the EUR 28,000 threshold of the first bracket, your marginal IRPEF rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')} -- the lowest possible.</p>
<p>The most impactful benefit at this salary level is the <strong>trattamento integrativo</strong>: with a taxable income at or below EUR 15,000, you are entitled to the full EUR 1,200 per year (EUR 100 per month), paid directly in your payslip. This effectively acts as a negative tax and meaningfully boosts your take-home pay. Additionally, the <strong>cuneo fiscale</strong> provides an exempt amount of 5.3% on the portion of income between EUR 8,501 and EUR 15,000, further reducing your taxable base before IRPEF is calculated.</p>
<p>The <strong>employment income deduction</strong> (detrazione per lavoro dipendente) at this income level is at its maximum value, absorbing a large share of the gross IRPEF. Combined with the trattamento integrativo, this creates an effective overall tax rate of just ${formatRate(defaultResult.aliquotaMedia, 'en')}, one of the lightest burdens in the Italian system. Your monthly net lands at approximately ${formatCurrency(defaultResult.nettoMensile, 'en')} on 13 pay periods.</p>
<p>Regional differences exist but are modest in absolute terms at this RAL: the gap between ${bestRegion.nome} (the best region for net pay) and ${worstRegion.nome} (the least favorable) is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month. While percentage-wise this gap is not negligible, the absolute amounts are small enough that other factors -- cost of living, job availability -- matter far more when choosing where to work.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(15_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>A RAL of ${formatCurrency(15_000, 'en')} translates to roughly ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month. By national standards, this is well below the Italian median salary of approximately EUR 29,000-30,000 gross. It is most commonly associated with part-time contracts, apprenticeships, or seasonal work rather than full-time permanent employment.</p>
<p>In terms of purchasing power, ${formatCurrency(defaultResult.nettoMensile, 'en')} per month can cover basic living costs in smaller southern cities -- Catania, Lecce, or Cosenza -- especially with shared housing. In Milan or Rome, independent living on this income is extremely challenging. For context, average rent for a one-bedroom apartment in Milan exceeds EUR 900, which alone would consume the vast majority of this monthly net.</p>
<p>If you earn at this level, it is worth verifying eligibility for means-tested benefits: the bonus bollette (utility bill discount), reduced university fees, and the Assegno Unico Universale for families with children can meaningfully supplement take-home pay. The full trattamento integrativo of EUR 100 per month is already included in the calculation above, but additional ISEE-linked benefits are not.</p>`,
  },
  18_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(18_000, 'en')} Gross Salary`,
    analysisBody: `<p>At a RAL of ${formatCurrency(18_000, 'en')}, your entire taxable income remains within the first IRPEF bracket at 23%. After INPS contributions of 9.19%, the taxable base is approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')}, comfortably below the EUR 28,000 threshold. Your marginal rate stays at ${formatRate(defaultResult.aliquotaMarginale, 'en')}, meaning any raise you negotiate will be taxed at the same percentage until you cross into the second bracket.</p>
<p>The <strong>trattamento integrativo</strong> still applies at this income level, though the mechanism changes: since your taxable income exceeds EUR 15,000, the full EUR 1,200 per year is granted only if total deductions (employment income deduction plus any other applicable deductions) exceed the gross IRPEF. In practice, for a single employee with no special deductions, the trattamento integrativo is typically still received in full or near-full at EUR 18,000. The <strong>cuneo fiscale</strong> exempt amount applies at 4.8% on income between EUR 15,001 and EUR 20,000, reducing the IRPEF base before the 23% rate is applied.</p>
<p>The <strong>employment income deduction</strong> remains generous at this level, though it begins to taper compared to lower incomes. The interplay between the tapering deduction, the cuneo exempt amount, and the trattamento integrativo results in an effective overall tax rate of ${formatRate(defaultResult.aliquotaMedia, 'en')}, still quite low by Italian standards. Your net monthly pay is approximately ${formatCurrency(defaultResult.nettoMensile, 'en')}.</p>
<p>The regional spread between ${bestRegion.nome} and ${worstRegion.nome} amounts to ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month. At this salary, regional surcharges (addizionali regionali) are calculated on modest taxable bases, so the absolute difference is contained -- but over a full year it adds up to roughly ${formatCurrency((bestRegion.nettoMensile - worstRegion.nettoMensile) * 13, 'en')}.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(18_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>A RAL of ${formatCurrency(18_000, 'en')} yields approximately ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month -- still below the national median, but sufficient for independent living in many mid-sized Italian cities. In places like Perugia, Cagliari, or Bari, this net can cover a modest apartment (EUR 350-450), utilities, food, and basic transportation, with a small margin for savings.</p>
<p>In northern metropolitan areas, particularly Milan, Turin, and Bologna, ${formatCurrency(defaultResult.nettoMensile, 'en')} requires careful budgeting and likely shared accommodation. A useful benchmark: housing costs should not exceed 35% of net income, which at this level means roughly ${formatCurrency(defaultResult.nettoMensile * 0.35, 'en')} per month for rent.</p>
<p>This salary is typical of first full-time employment contracts in the service sector and represents a stepping stone. Workers at this level should focus on career development to reach the EUR 22,000-25,000 range within 2-3 years, while taking advantage of all available tax benefits, including the trattamento integrativo and any applicable ISEE-linked subsidies.</p>`,
  },
  20_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(20_000, 'en')} Gross Salary`,
    analysisBody: `<p>A RAL of ${formatCurrency(20_000, 'en')} keeps your entire taxable income within the first IRPEF bracket at 23%. With INPS contributions deducted, your fiscal taxable base is approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')}. The marginal rate of ${formatRate(defaultResult.aliquotaMarginale, 'en')} will apply to every additional euro of income until the taxable base exceeds EUR 28,000.</p>
<p>This RAL sits at a transitional point for the <strong>cuneo fiscale</strong> exempt amount: income up to EUR 20,000 benefits from a percentage-based reduction of the IRPEF taxable base (4.8% on the EUR 15,001-20,000 slice). Above EUR 20,000, the mechanism switches from an exempt amount to a fixed deduction of EUR 1,000 per year. At exactly EUR 20,000, you receive the final tranche of the exempt amount, which shaves a few hundred euros off your taxable income before IRPEF kicks in.</p>
<p>The <strong>trattamento integrativo</strong> at this level is conditional: since taxable income exceeds EUR 15,000, the EUR 1,200 annual benefit is granted only if total deductions exceed gross IRPEF. For a typical single employee, this condition is generally met at EUR 20,000, so the benefit is usually received. However, if you have few deductions, it is worth verifying with your employer's payroll office. The effective tax rate comes to ${formatRate(defaultResult.aliquotaMedia, 'en')}, producing a monthly net of ${formatCurrency(defaultResult.nettoMensile, 'en')}.</p>
<p>Between ${bestRegion.nome} and ${worstRegion.nome}, the monthly net difference is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')}. This is driven entirely by differing regional surcharge rates -- some regions like Lazio apply progressive rates that hit even moderate incomes with noticeable surcharges, while others like Friuli-Venezia Giulia maintain flat, low rates.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(20_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>At ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, a RAL of ${formatCurrency(20_000, 'en')} is roughly 30% below the national median. It represents the entry threshold for many full-time positions in the service sector -- junior accounting clerks, call center operators, logistics assistants. While below average, it is a common starting salary for workers under 30.</p>
<p>Purchasing power varies dramatically by location. In southern and central cities (Lecce, Potenza, Pescara), this income supports a decent quality of life for a single person. In the industrial north, it is livable but tight. In Milan, where the cost of living is among the highest in Italy, ${formatCurrency(defaultResult.nettoMensile, 'en')} requires careful expense management and likely a flatshare.</p>
<p>One tax-free benefit worth maximizing at this level: electronic meal vouchers of EUR 8 per day, if offered by your employer, add approximately EUR 168 per month in purchasing power that is completely exempt from both INPS and IRPEF -- effectively a 15% boost to your monthly net.</p>`,
  },
  22_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(22_000, 'en')} Gross Salary`,
    analysisBody: `<p>With a RAL of ${formatCurrency(22_000, 'en')}, your fiscal taxable income after INPS contributions is approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')}, still contained within the first IRPEF bracket (23% on income up to EUR 28,000). The marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}. You are now roughly EUR 8,000 of taxable income away from the critical EUR 28,000 threshold where the rate jumps to 33%.</p>
<p>At this income level, the <strong>cuneo fiscale</strong> mechanism has shifted from the exempt-amount system (applicable up to EUR 20,000) to the <strong>fixed deduction of EUR 1,000 per year</strong>, which applies fully between EUR 20,001 and EUR 32,000 of income. This deduction is applied directly to the IRPEF due, functioning like an additional tax credit on top of the standard employment income deduction. It is worth approximately EUR 83 extra net per month.</p>
<p>The <strong>trattamento integrativo</strong> is entering uncertain territory at EUR 22,000. The benefit is still potentially available (since income is below EUR 28,000), but only on condition that total deductions exceed gross IRPEF. For a single employee with no dependent family members and no special deductible expenses, this condition may or may not be met depending on exact regional and municipal surcharge calculations. If it is not met, you lose EUR 100 per month -- a significant hit at this income level.</p>
<p>The gap between ${bestRegion.nome} and ${worstRegion.nome} is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month (approximately ${formatCurrency((bestRegion.nettoMensile - worstRegion.nettoMensile) * 13, 'en')} per year). This is beginning to represent a meaningful amount: enough to cover a month's utility bills or a weekend trip. The effective overall rate stands at ${formatRate(defaultResult.aliquotaMedia, 'en')}, yielding ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(22_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>A monthly net of ${formatCurrency(defaultResult.nettoMensile, 'en')} from a RAL of ${formatCurrency(22_000, 'en')} is approximately 25% below the Italian median. This salary is typical for workers in their first 3-5 years of career in administrative, technical, or social service roles. It is below average but not unusual for the Italian labor market, where wage growth tends to be slow in the early career years.</p>
<p>In practical terms, ${formatCurrency(defaultResult.nettoMensile, 'en')} per month allows for independent living in most Italian cities outside the expensive northern metros. A single person in a city like Padova, Verona, or Florence can manage rent, food, and transport, though discretionary spending remains limited. The key financial concern at this level should be avoiding consumer debt and starting -- even modestly -- a savings habit.</p>
<p>An important consideration for workers at EUR 22,000: the path to EUR 28,000 is crucial. Every raise negotiated between now and that threshold is taxed at only 23%, making this the most tax-efficient growth window. Once past EUR 28,000, each additional euro will be taxed at 33% -- a 10 percentage-point jump that significantly reduces the net impact of future raises.</p>`,
  },
  25_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(25_000, 'en')} Gross Salary`,
    analysisBody: `<p>A RAL of ${formatCurrency(25_000, 'en')} produces a fiscal taxable income of approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')} after INPS deductions. This amount remains within the first IRPEF bracket (23%), with the marginal rate at ${formatRate(defaultResult.aliquotaMarginale, 'en')}. You are now approaching the Italian median salary, and the EUR 28,000 bracket boundary is within reach -- roughly EUR 5,000 of taxable income away.</p>
<p>The <strong>cuneo fiscale deduction of EUR 1,000 per year</strong> applies fully at this income level (the full amount is available for incomes between EUR 20,001 and EUR 32,000). This acts as a direct reduction of your IRPEF bill, equivalent to approximately EUR 77 extra net per month. Combined with the standard employment income deduction (detrazione lavoro dipendente), which is still relatively generous at this taxable base, these credits meaningfully reduce your effective tax burden.</p>
<p>The <strong>trattamento integrativo</strong> may or may not apply at EUR 25,000. The check compares total deductions against gross IRPEF for incomes between EUR 15,001 and EUR 28,000. At EUR 25,000, the outcome depends on your specific situation (region of residence, municipal rate, dependent family members). If you receive it, the benefit adds EUR 100 per month; if not, there is a notable difference in take-home pay. Your payslip should indicate whether the employer is applying it.</p>
<p>Regional variation between ${bestRegion.nome} and ${worstRegion.nome} amounts to ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month. The overall effective rate is ${formatRate(defaultResult.aliquotaMedia, 'en')}, and you take home ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month over 13 pay periods.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(25_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>With ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, a RAL of ${formatCurrency(25_000, 'en')} is approaching but still below the Italian median of approximately EUR 29,000-30,000. It is a solid salary for workers with 3-5 years of experience in administrative, technical, or public-sector roles, and represents the backbone of the Italian middle class in terms of wage distribution.</p>
<p>Purchasing power at this level is location-dependent. In cities like Naples, Palermo, or Catania, ${formatCurrency(defaultResult.nettoMensile, 'en')} provides a comfortable standard of living for a single person, including the possibility of renting a small apartment independently. In Milan or Rome, it covers basic needs but leaves little room for savings or discretionary spending without careful budgeting.</p>
<p>Financial planning should focus on building an emergency fund of 3-4 months of expenses (approximately ${formatCurrency(defaultResult.nettoMensile * 3.5, 'en')}), and beginning contributions to a sector pension fund. Even small monthly pension fund contributions at this stage -- EUR 50-100 per month -- benefit from decades of compound growth and the 23% tax deduction on contributions.</p>`,
  },
  27_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(27_000, 'en')} Gross Salary`,
    analysisBody: `<p>A RAL of ${formatCurrency(27_000, 'en')} generates a fiscal taxable income of approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')} after INPS. This sits very close to the critical EUR 28,000 threshold that separates the first IRPEF bracket (23%) from the second (33%). Your marginal rate is currently ${formatRate(defaultResult.aliquotaMarginale, 'en')}, but a modest raise could push your taxable income past EUR 28,000, subjecting the excess to a 10-percentage-point higher rate.</p>
<p>This proximity to the bracket boundary creates what tax professionals call a <strong>"fiscal cliff" effect</strong>. A EUR 2,000 gross raise from EUR 27,000 to EUR 29,000 does not produce a proportional net increase, because the portion of taxable income above EUR 28,000 is taxed at 33% instead of 23%. Moreover, crossing EUR 28,000 definitively eliminates eligibility for the <strong>trattamento integrativo</strong> (EUR 1,200 per year), which may still be partially available at EUR 27,000. The combined effect means a gross raise could yield surprisingly little additional net income -- or in edge cases, even reduce it.</p>
<p>The <strong>cuneo fiscale deduction</strong> of EUR 1,000 per year is fully active at this RAL (it applies in full between EUR 20,001 and EUR 32,000). This and the employment income deduction together provide meaningful IRPEF relief. The effective overall rate is ${formatRate(defaultResult.aliquotaMedia, 'en')}, resulting in ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month.</p>
<p>If your employer offers a choice between a modest gross raise and tax-exempt benefits (meal vouchers, corporate welfare, pension fund contributions), the benefit route is often more tax-efficient at this specific RAL. The regional gap between ${bestRegion.nome} and ${worstRegion.nome} is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(27_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>At ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, a RAL of ${formatCurrency(27_000, 'en')} is just below the national median. It represents fair compensation for secondary school teachers in their first decade, nurses with some seniority, banking clerks, and IT technicians. By ISTAT statistics, roughly half of Italian employees earn less than this.</p>
<p>The purchasing power of ${formatCurrency(defaultResult.nettoMensile, 'en')} supports independent living in all Italian cities, though with varying degrees of comfort. In affordable areas (smaller cities in the South and Center), it allows for savings. In expensive metro areas (Milan, Rome, Bologna), it requires trade-offs between housing quality, location, and other spending.</p>
<p>Strategically, this is a pivotal salary: you are at the doorstep of the EUR 28,000 bracket boundary. If you can negotiate your next raise in the form of welfare benefits rather than gross salary, you may preserve trattamento integrativo eligibility while still increasing your real compensation. This is one of the few points in the Italian tax system where such negotiation can make a tangible difference.</p>`,
  },
  28_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(28_000, 'en')} Gross Salary`,
    analysisBody: `<p>A RAL of ${formatCurrency(28_000, 'en')} sits at the single most important threshold in the Italian IRPEF system: EUR 28,000 is the exact boundary between the first bracket (23%) and the second bracket (33%). Your fiscal taxable income after INPS is approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')}. Depending on the exact relationship between your taxable income and EUR 28,000, your marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}.</p>
<p>The significance of this threshold cannot be overstated. <strong>Every euro of taxable income above EUR 28,000 is taxed at 33% instead of 23%</strong> -- a 10-percentage-point jump, the largest single bracket transition in the Italian system. In practical terms, a EUR 1,000 gross increase that pushes taxable income from EUR 28,000 to EUR 29,000 yields only about EUR 580 in additional annual net, compared to roughly EUR 670 for the same increase below the threshold.</p>
<p>The <strong>trattamento integrativo ends definitively at EUR 28,000</strong>. Below this threshold, eligible employees receive up to EUR 1,200 per year (EUR 100 per month). Above it, the benefit vanishes entirely. This creates a "cliff" where someone earning EUR 28,000 can take home more net than someone earning EUR 29,000, depending on individual circumstances. The <strong>cuneo fiscale deduction</strong> of EUR 1,000 per year still applies fully (valid up to EUR 32,000), partially offsetting the bracket transition.</p>
<p>Your effective rate is ${formatRate(defaultResult.aliquotaMedia, 'en')}, and monthly net is ${formatCurrency(defaultResult.nettoMensile, 'en')}. The regional difference between ${bestRegion.nome} and ${worstRegion.nome} is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month. At this exact salary, negotiating tax-exempt compensation (meal vouchers, welfare, pension contributions) instead of gross raises is one of the smartest financial moves an Italian employee can make.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(28_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>A RAL of ${formatCurrency(28_000, 'en')} produces approximately ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, positioning you at or very near the Italian median salary. This is the statistical center of the Italian wage distribution -- roughly half of all employees earn more, and half earn less. Common roles at this level include HR specialists, junior data analysts, senior laboratory technicians, and mid-career administrative professionals.</p>
<p>In terms of living standards, ${formatCurrency(defaultResult.nettoMensile, 'en')} per month supports a modest but comfortable lifestyle for a single person in most Italian cities. Shared expenses with a partner make this income quite livable even in expensive areas. However, building significant savings or purchasing property on a single income at this level requires discipline and a long time horizon.</p>
<p>From a career perspective, EUR 28,000 is a psychologically and fiscally important marker. Once past this point, future gross raises are less tax-efficient (33% bracket). Workers at this level should invest in skills and certifications that can propel them to EUR 35,000-40,000, where compensation comfortably outpaces the bracket penalty despite the higher marginal rate.</p>`,
  },
  30_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(30_000, 'en')} Gross Salary`,
    analysisBody: `<p>At a RAL of ${formatCurrency(30_000, 'en')}, your fiscal taxable income is approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')} after INPS contributions. A portion of this income falls within the second IRPEF bracket (33%), which applies to taxable income between EUR 28,001 and EUR 50,000. Your marginal rate is now ${formatRate(defaultResult.aliquotaMarginale, 'en')}, meaning every additional euro of gross salary produces noticeably less net income than it did below EUR 28,000.</p>
<p>The <strong>cuneo fiscale deduction of EUR 1,000 per year</strong> is fully active at this income level (it applies without phase-out between EUR 20,001 and EUR 32,000). This deduction is applied directly against your IRPEF liability, reducing your tax bill by EUR 1,000 annually -- roughly EUR 77 extra per month. Without this benefit, your effective rate would be even higher. The standard <strong>employment income deduction</strong> is still meaningful here, though it has begun tapering from its maximum values seen at lower incomes.</p>
<p>The <strong>trattamento integrativo is no longer available</strong> at EUR 30,000, having been definitively cut off at the EUR 28,000 income threshold. This means you have lost EUR 1,200 per year compared to the benefit available at lower salaries. It is one of the reasons why the net difference between a EUR 25,000 and a EUR 30,000 RAL is smaller than many workers expect when they see the gross figures.</p>
<p>Regional variation is becoming more pronounced: ${bestRegion.nome} offers ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month more than ${worstRegion.nome}, which over a year equals ${formatCurrency((bestRegion.nettoMensile - worstRegion.nettoMensile) * 13, 'en')}. The effective overall rate is ${formatRate(defaultResult.aliquotaMedia, 'en')}, yielding ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(30_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>A RAL of ${formatCurrency(30_000, 'en')} produces ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, placing you right around the Italian median. This is the most common salary bracket in the country and is typical of junior software developers, employed accountants, sales engineers, and professional educators with public contracts.</p>
<p>In terms of quality of life, ${formatCurrency(defaultResult.nettoMensile, 'en')} per month provides a comfortable baseline in most Italian cities. In the South and smaller northern cities, this income supports independent living with room for saving. In Milan, a single person can manage with careful budgeting, though luxury is limited. The crucial advantage at this level is stability: EUR 30,000 roles tend to come with permanent contracts (contratto a tempo indeterminato), which unlock access to mortgages and long-term financial planning.</p>
<p>Compared to European peers, an Italian worker earning EUR 30,000 takes home less net than equivalents in Germany or France at the same gross level, primarily due to higher INPS contributions and the progressive IRPEF structure. However, the lower cost of living in many Italian cities partially compensates for this difference.</p>`,
  },
  32_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(32_000, 'en')} Gross Salary`,
    analysisBody: `<p>With a RAL of ${formatCurrency(32_000, 'en')}, your fiscal taxable income after INPS is approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')}. A meaningful portion now falls within the second IRPEF bracket at 33% (applicable to income between EUR 28,001 and EUR 50,000). The marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}, and the effective average rate stands at ${formatRate(defaultResult.aliquotaMedia, 'en')}.</p>
<p>This RAL sits at another critical boundary: EUR 32,000 is the <strong>upper limit for the full cuneo fiscale deduction of EUR 1,000 per year</strong>. Above EUR 32,000, this deduction begins a linear phase-out, declining to zero at EUR 40,000. This means a raise from EUR 32,000 to EUR 33,000 not only subjects the additional income to the 33% bracket but also begins reducing the cuneo deduction, creating an implicit marginal rate that can exceed 40% in this narrow zone. This "double penalty" makes the EUR 32,000-40,000 corridor one of the least tax-efficient growth ranges in the Italian system.</p>
<p>The <strong>employment income deduction</strong> continues to taper at this income level. Combined with the loss of the trattamento integrativo (eliminated at EUR 28,000) and the approaching phase-out of the cuneo deduction, workers at EUR 32,000 experience what might be called "tax benefit erosion" -- each mechanism of relief is either already gone or about to be reduced.</p>
<p>The gap between ${bestRegion.nome} and ${worstRegion.nome} is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month. Your monthly net is approximately ${formatCurrency(defaultResult.nettoMensile, 'en')}. At this precise RAL, contributing to a <strong>complementary pension fund</strong> is especially attractive: the 33% marginal rate means every EUR 1,000 contributed saves EUR 330 in taxes, up to the annual deductible ceiling of EUR 5,164.57.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(32_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>At ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, a RAL of ${formatCurrency(32_000, 'en')} is slightly above the Italian median. It is a typical salary for front-end developers with a few years of experience, junior financial analysts, physiotherapists, and secondary school teachers with 15-20 years of seniority. You are in the upper half of the Italian wage distribution, but not yet in the higher brackets.</p>
<p>This income level supports comfortable living in most of Italy. A single person can rent a decent apartment, cover all expenses, and still save ${formatCurrency(defaultResult.nettoMensile * 0.15, 'en')}-${formatCurrency(defaultResult.nettoMensile * 0.2, 'en')} per month with discipline. In Milan, it is achievable but requires thoughtful housing choices. In mid-sized cities like Bologna, Verona, or Florence, it provides a good quality of life.</p>
<p>From a financial planning standpoint, this is the last RAL where the full cuneo fiscale deduction applies. Workers who expect salary growth in the coming years should maximize tax-advantaged savings now, particularly through pension fund contributions, which offer a 33% immediate tax return on the contributed amount.</p>`,
  },
  35_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(35_000, 'en')} Gross Salary`,
    analysisBody: `<p>A RAL of ${formatCurrency(35_000, 'en')} places your fiscal taxable income at approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')} after INPS deductions. A substantial portion of this falls in the second IRPEF bracket at 33%, and your marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}. The effective overall rate has climbed to ${formatRate(defaultResult.aliquotaMedia, 'en')}, reflecting the cumulative impact of INPS, IRPEF, and surcharges.</p>
<p>At EUR 35,000, the <strong>cuneo fiscale deduction is in the midst of its phase-out</strong>. Between EUR 32,001 and EUR 40,000, the deduction declines linearly from EUR 1,000 to zero. At EUR 35,000, you receive approximately EUR 625 of the original EUR 1,000 deduction. This creates an implicit additional marginal rate: for every EUR 1,000 of additional income in this range, you lose about EUR 125 of cuneo deduction on top of paying 33% IRPEF on the excess. The combined effective marginal rate in this zone can reach approximately 37-38% before surcharges.</p>
<p>The <strong>employment income deduction</strong> is still present but noticeably reduced compared to lower income levels. No trattamento integrativo is available (that ended at EUR 28,000). The combination of a significant portion of income in the 33% bracket, declining cuneo deduction, and reduced employment deduction means the tax system is progressively withdrawing its support mechanisms.</p>
<p>The regional spread between ${bestRegion.nome} and ${worstRegion.nome} is now ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month -- approximately ${formatCurrency((bestRegion.nettoMensile - worstRegion.nettoMensile) * 13, 'en')} per year. For a remote worker considering relocation, this difference is equivalent to a small pay raise. Monthly net is ${formatCurrency(defaultResult.nettoMensile, 'en')}.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(35_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>A RAL of ${formatCurrency(35_000, 'en')} produces ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, placing you 15-20% above the Italian median. This salary is typical of mid-level software developers, junior project managers, employed accountants with 5 years of experience, and head nurses. It represents a solid professional achievement in the Italian context.</p>
<p>At this income level, a single person can live comfortably in any Italian city, including Milan and Rome, though luxury remains limited in the most expensive neighborhoods. Saving ${formatCurrency(defaultResult.nettoMensile * 0.2, 'en')} per month (20% of net) is achievable with moderate discipline. Property purchase becomes a realistic medium-term goal, particularly in cities outside the top-tier metros.</p>
<p>In a European comparison, EUR 35,000 in Italy generates lower purchasing power than equivalent gross salaries in Germany, France, or the Netherlands, due to both higher tax wedge and lower gross starting points. However, for workers who value Italy's quality of life -- climate, food, culture, healthcare -- this salary provides a good balance of comfort and financial security.</p>`,
  },
  38_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(38_000, 'en')} Gross Salary`,
    analysisBody: `<p>At a RAL of ${formatCurrency(38_000, 'en')}, your taxable income after INPS contributions reaches approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')}. The second IRPEF bracket at 33% now covers a substantial slice of your income, with a marginal rate of ${formatRate(defaultResult.aliquotaMarginale, 'en')} and an effective average rate of ${formatRate(defaultResult.aliquotaMedia, 'en')}.</p>
<p>The <strong>cuneo fiscale deduction is nearly exhausted</strong> at this income level. At EUR 38,000, only approximately EUR 250 of the original EUR 1,000 deduction remains (it phases out linearly between EUR 32,000 and EUR 40,000). By EUR 40,000, it will be gone entirely. This accelerating loss of the cuneo deduction means the effective marginal rate in the EUR 35,000-40,000 range is higher than what the nominal 33% bracket suggests -- closer to 38-40% when accounting for the simultaneous reduction of the deduction.</p>
<p>The <strong>employment income deduction</strong> is now quite reduced compared to its peak values at lower incomes, though it has not yet disappeared (it fully phases out at EUR 50,000 of taxable income). No trattamento integrativo, no cuneo exempt amounts -- the progressive unwinding of tax benefits is nearly complete. What remains are the base IRPEF brackets and the standard deductions.</p>
<p>Regional differences between ${bestRegion.nome} and ${worstRegion.nome} amount to ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month. At this salary level, the choice of region has a real financial impact: the annual difference of approximately ${formatCurrency((bestRegion.nettoMensile - worstRegion.nettoMensile) * 13, 'en')} exceeds the cost of many tax optimization strategies. Your monthly net is ${formatCurrency(defaultResult.nettoMensile, 'en')}.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(38_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>With ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, a RAL of ${formatCurrency(38_000, 'en')} places you comfortably above the Italian median. This level is achieved by experienced full-stack developers, financial controllers, marketing managers, and process engineers. It represents strong mid-career compensation by Italian standards.</p>
<p>The purchasing power of ${formatCurrency(defaultResult.nettoMensile, 'en')} supports a good quality of life anywhere in Italy. In Milan, it covers a decent apartment, all necessities, and leaves room for savings and leisure. In less expensive cities, it allows for a very comfortable lifestyle with meaningful monthly savings. A 20% savings target of ${formatCurrency(defaultResult.nettoMensile * 0.2, 'en')} per month is realistic.</p>
<p>One area for attention: workers at EUR 38,000 are often in the "missing middle" of Italian welfare -- earning too much for means-tested benefits but not yet at income levels where sophisticated tax planning yields large absolute savings. The best strategy at this level is maximizing tax-exempt employer benefits (meal vouchers, welfare, health insurance) and starting or increasing pension fund contributions, where the 33% marginal rate provides a solid tax deduction.</p>`,
  },
  40_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(40_000, 'en')} Gross Salary`,
    analysisBody: `<p>A RAL of ${formatCurrency(40_000, 'en')} generates a fiscal taxable income of approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')} after INPS contributions. A large portion falls in the second IRPEF bracket at 33%. Your marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}, and the effective average rate has reached ${formatRate(defaultResult.aliquotaMedia, 'en')}.</p>
<p>EUR 40,000 marks the <strong>complete exhaustion of the cuneo fiscale</strong>. The deduction, which was worth EUR 1,000 at EUR 32,000 and gradually declined, reaches zero at EUR 40,000 of income. From this point forward, there is no cuneo benefit whatsoever -- neither exempt amounts (those ended at EUR 20,000) nor deductions. This is the salary level where the last cuneo-related support mechanism disappears from your payslip.</p>
<p>The <strong>employment income deduction</strong> is still partially active but reduced, as it continues its phase-out toward complete elimination at EUR 50,000 of taxable income. The trattamento integrativo has been absent since EUR 28,000. In essence, at EUR 40,000 you are in a zone where the Italian tax system offers minimal relief mechanisms beyond the basic progressive bracket structure itself.</p>
<p>The monthly net of ${formatCurrency(defaultResult.nettoMensile, 'en')} reflects this stripped-down tax landscape. Between ${bestRegion.nome} and ${worstRegion.nome}, the difference is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month. Tax optimization at this level centers on the <strong>complementary pension fund</strong>: at a 33% marginal rate, the maximum deductible contribution of EUR 5,164.57 produces a tax saving of approximately EUR 1,700 per year -- one of the highest-impact single financial decisions you can make.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(40_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>A monthly net of ${formatCurrency(defaultResult.nettoMensile, 'en')} from a RAL of ${formatCurrency(40_000, 'en')} puts you well above the Italian median, in roughly the top 30-35% of employees. This is a common salary for team leaders in IT, senior accountants, purchasing managers, and engineers with 7-10 years of experience. It is also the entry level for managerial-grade staff under several collective agreements.</p>
<p>At ${formatCurrency(defaultResult.nettoMensile, 'en')} per month, you can live very comfortably in most Italian cities. In Milan, you can afford a decent one-bedroom apartment on your own and still save. In central-southern cities, this income provides an excellent standard of living. Property purchase becomes a concrete possibility, with sustainable mortgage payments of ${formatCurrency(defaultResult.nettoMensile * 0.3, 'en')} supporting loans of EUR 150,000-160,000 over 25 years.</p>
<p>However, comparison with European peers reveals the Italian gap: the same EUR 40,000 gross in Germany or the Netherlands would produce notably higher net pay, thanks to different social contribution structures and tax brackets. For internationally mobile professionals, this salary differential is one reason Italy struggles to retain mid-career talent.</p>`,
  },
  42_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(42_000, 'en')} Gross Salary`,
    analysisBody: `<p>With a RAL of ${formatCurrency(42_000, 'en')}, your fiscal taxable income reaches approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')}. The bulk of the income exceeding EUR 28,000 of taxable base is in the second IRPEF bracket at 33%. The marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}, and the effective average rate is ${formatRate(defaultResult.aliquotaMedia, 'en')}.</p>
<p>At this income level, <strong>all cuneo fiscale benefits have been fully exhausted</strong> (they phase out at EUR 40,000). The <strong>employment income deduction</strong> is still partially available but increasingly diminished, as it declines toward zero at EUR 50,000 of taxable income. You are in a zone where the tax system provides minimal relief: the trattamento integrativo is long gone (capped at EUR 28,000), the cuneo deduction has expired, and the employment deduction is shrinking rapidly.</p>
<p>This creates a situation where the <strong>implicit marginal tax rate is deceptively high</strong>. While the nominal IRPEF bracket is 33%, the simultaneous reduction of the employment deduction adds an additional implicit charge on each extra euro earned. When you factor in INPS contributions (9.19%) and regional/municipal surcharges, the true all-in marginal rate for a worker at EUR 42,000 can approach 45%. This explains why the gap between gross and net feels increasingly steep at this level.</p>
<p>Between ${bestRegion.nome} and ${worstRegion.nome}, the monthly difference is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')}. Monthly net pay is ${formatCurrency(defaultResult.nettoMensile, 'en')}. Contributing to a pension fund remains the single most effective tax lever: the deduction at 33% on contributions up to EUR 5,164.57 saves you approximately EUR 1,700 per year.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(42_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>A RAL of ${formatCurrency(42_000, 'en')} produces ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, positioning you in approximately the top 25-30% of Italian employees. This is achieved by senior developers, DevOps engineers, product managers, and HR managers in SMEs. It represents solid professional maturity and typically comes with a permanent contract and some level of responsibility.</p>
<p>At this net income, quality of life in Italy is good across all cities. Saving ${formatCurrency(defaultResult.nettoMensile * 0.2, 'en')} per month is feasible without significant lifestyle sacrifice. A couple where both partners earn around this level enjoys a combined household income that places them firmly in the Italian upper-middle class, with access to property, travel, and long-term investment.</p>
<p>The "is it good?" question also depends on sector context. In Italian banking or pharma, EUR 42,000 is a mid-career salary. In tech, it is competitive but below what international companies pay for equivalent roles. In the public sector, reaching EUR 42,000 typically requires significant seniority. For international professionals considering Italy, this salary is livable and comfortable, though lower than what the same role would pay in northern Europe.</p>`,
  },
  45_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(45_000, 'en')} Gross Salary`,
    analysisBody: `<p>At a RAL of ${formatCurrency(45_000, 'en')}, your fiscal taxable income after INPS is approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')}. Nearly all of the income above EUR 28,000 is taxed at 33%, and you are now approaching the <strong>EUR 50,000 threshold</strong> where the third and highest IRPEF bracket (43%) begins. The marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}, and the overall effective rate is ${formatRate(defaultResult.aliquotaMedia, 'en')}.</p>
<p>The <strong>employment income deduction</strong> is in its final stages of phase-out. It declines linearly between EUR 28,000 and EUR 50,000 of taxable income, and at your current taxable base it provides only a modest reduction. All other major benefits -- trattamento integrativo, cuneo fiscale -- are long exhausted. The practical consequence is that the Italian tax system at EUR 45,000 is essentially "naked" progressivity: IRPEF brackets plus surcharges, with minimal deductions to soften the blow.</p>
<p>An important forward-looking consideration: if your salary grows to EUR 50,000+ gross, the portion of taxable income above EUR 50,000 will be taxed at <strong>43% instead of 33%</strong> -- another 10-percentage-point jump. Planning for this transition means understanding that a gross raise from EUR 45,000 to EUR 55,000 will be less tax-efficient per euro than the previous EUR 35,000 to EUR 45,000 growth.</p>
<p>The regional difference between ${bestRegion.nome} and ${worstRegion.nome} is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month (${formatCurrency((bestRegion.nettoMensile - worstRegion.nettoMensile) * 13, 'en')} per year). Monthly net pay is ${formatCurrency(defaultResult.nettoMensile, 'en')}. The pension fund deduction at this marginal rate provides approximately EUR 1,700 in annual savings on maximum contributions.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(45_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>A monthly net of ${formatCurrency(defaultResult.nettoMensile, 'en')} from a RAL of ${formatCurrency(45_000, 'en')} places you in the top 20-25% of Italian employees. This salary is typical of senior software engineers, regional sales managers, certified project managers, and CCNL Metalmeccanico managers with department-level responsibility. It represents a strong professional standing.</p>
<p>At this income, you can live very comfortably in any Italian city, save regularly, and plan for major purchases like property. A sustainable mortgage payment of ${formatCurrency(defaultResult.nettoMensile * 0.3, 'en')} per month supports significant borrowing. A family of three or four with one parent at EUR 45,000 and the other at a median salary enjoys a solidly upper-middle-class life in Italy.</p>
<p>The frustration many workers at this level express is the heavy tax burden: the effective rate of ${formatRate(defaultResult.aliquotaMedia, 'en')} means a substantial fraction of gross income goes to taxes and contributions. Comparing with peers in Germany, France, or the UK at the same gross level, Italian workers often receive less net pay. This is a key driver of the "brain drain" that Italy has experienced among mid-career professionals in recent years.</p>`,
  },
  50_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(50_000, 'en')} Gross Salary`,
    analysisBody: `<p>A RAL of ${formatCurrency(50_000, 'en')} represents the second major fiscal watershed in the Italian tax system. Your taxable income after INPS is approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')}, which is at or near the EUR 50,000 boundary between the second IRPEF bracket (33%) and the third bracket (43%). The marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}, and the effective rate stands at ${formatRate(defaultResult.aliquotaMedia, 'en')}.</p>
<p><strong>EUR 50,000 of taxable income is where the 43% bracket begins</strong>, and it applies to all income above this threshold with no upper limit. This means every additional euro above EUR 50,000 of taxable income is taxed at the maximum IRPEF rate -- a 10-percentage-point jump from the 33% bracket below. Unlike the EUR 28,000 threshold, there is no higher bracket beyond 43%, so this rate persists regardless of how much more you earn.</p>
<p>The <strong>employment income deduction is completely exhausted</strong> at EUR 50,000 of taxable income. This is the point where all standard IRPEF deduction mechanisms have been fully phased out. From here forward, there are no automatic deductions to reduce your IRPEF bill -- only specific personal deductions (mortgage interest, medical expenses, pension fund contributions) apply. The effective marginal rate, when combining INPS, IRPEF at 43%, and regional/municipal surcharges, can exceed 50% on each additional euro earned.</p>
<p>The regional gap between ${bestRegion.nome} and ${worstRegion.nome} is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month. Monthly net is ${formatCurrency(defaultResult.nettoMensile, 'en')}. The <strong>pension fund becomes an imperative optimization tool</strong>: at a potential 43% marginal rate, the maximum deductible contribution of EUR 5,164.57 saves approximately EUR 2,200 in IRPEF per year.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(50_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>With ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, a RAL of ${formatCurrency(50_000, 'en')} positions you in the top 15-20% of Italian employees. This is the threshold for engineering managers, senior consultants, department heads, employed hospital physicians, and senior managerial staff. It is also just below the typical entry salary for CCNL Dirigenti Industria executives.</p>
<p>At this income, financial security is solid. A single person lives very comfortably in any Italian city, and a couple with one partner at EUR 50,000 and the other at median salary enjoys an upper-middle-class lifestyle. Property purchase, regular investment, and comfortable leisure spending are all achievable. The recommended portfolio allocation at this level includes a diversified mix of ETFs and bonds, with the pension fund maximized for tax efficiency.</p>
<p>The key frustration is the marginal rate cliff: every future euro above EUR 50,000 of taxable income faces the 43% IRPEF rate. This makes gross raises above this level feel disappointing in net terms. For internationally mobile professionals, EUR 50,000 is the salary level where the Italian tax disadvantage relative to Germany, France, Switzerland, or the UK becomes starkly visible and increasingly drives emigration decisions.</p>`,
  },
  55_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(55_000, 'en')} Gross Salary`,
    analysisBody: `<p>With a RAL of ${formatCurrency(55_000, 'en')}, your fiscal taxable income is approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')} after INPS deductions. A portion of this income -- roughly ${formatCurrency(defaultResult.imponibileFiscale - 50_000 > 0 ? defaultResult.imponibileFiscale - 50_000 : 0, 'en')} -- falls in the third IRPEF bracket at 43%, the highest marginal rate in the Italian system. Your marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}, and the effective average rate is ${formatRate(defaultResult.aliquotaMedia, 'en')}.</p>
<p>At EUR 55,000, the <strong>full weight of the progressive system</strong> is felt. All deduction mechanisms are exhausted: no trattamento integrativo (eliminated at EUR 28,000), no cuneo fiscale (phased out at EUR 40,000), no employment income deduction (eliminated at EUR 50,000 of taxable income). The only remaining IRPEF reductions come from specific personal deductions -- pension fund contributions, mortgage interest on primary residence (up to EUR 4,000 of interest per year), medical expenses (19% deduction above EUR 129.11), and dependent family member deductions if applicable.</p>
<p>The <strong>all-in marginal cost of an additional euro</strong> is substantial at this level: 9.19% INPS + 43% IRPEF on the incremental taxable income + approximately 1.5-3% regional and municipal surcharges, totaling a marginal take of roughly 50-52% on each additional euro of gross salary. This makes non-monetary compensation -- company car, supplementary health insurance, corporate welfare -- proportionally more valuable than at lower income levels.</p>
<p>Between ${bestRegion.nome} and ${worstRegion.nome}, the monthly gap is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')}. Monthly net is ${formatCurrency(defaultResult.nettoMensile, 'en')}. At this salary, comprehensive tax planning -- combining pension fund maximization, careful use of deductions, and benefit negotiation -- can recover EUR 2,000-3,000 per year in net income.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(55_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>A RAL of ${formatCurrency(55_000, 'en')} yields ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, placing you in the top 12-15% of Italian employees. This salary is typical for senior managers, solution architects, department heads, and hospital specialists with seniority. It reflects significant professional experience and responsibility.</p>
<p>Quality of life at ${formatCurrency(defaultResult.nettoMensile, 'en')} per month is very good by Italian standards. A single person can live comfortably even in Milan, and a family can maintain an upper-middle-class lifestyle in most cities. Regular saving and investment are easily achievable, and property ownership is well within reach.</p>
<p>The "tax paradox" becomes particularly visible at this level: the effective rate of ${formatRate(defaultResult.aliquotaMedia, 'en')} means more than a third of your gross goes to the state. For workers with international experience or options, this creates a constant pull toward lower-tax jurisdictions. Italy's counter-offer -- the regime impatriati for returning workers -- can cut the taxable base by 50%, but it is only available to those who have lived abroad for a qualifying period. For those eligible, it transforms a EUR 55,000 salary into an exceptionally competitive net proposition.</p>`,
  },
  60_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(60_000, 'en')} Gross Salary`,
    analysisBody: `<p>A RAL of ${formatCurrency(60_000, 'en')} produces a fiscal taxable income of approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')} after INPS contributions. A significant portion of this -- roughly ${formatCurrency(defaultResult.imponibileFiscale - 50_000 > 0 ? defaultResult.imponibileFiscale - 50_000 : 0, 'en')} -- is taxed at the top 43% IRPEF rate. The marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}, and the effective average rate is ${formatRate(defaultResult.aliquotaMedia, 'en')}, meaning more than one-third of total gross income goes to taxes and social contributions.</p>
<p>At this income level, the IRPEF calculation becomes straightforward but heavy: 23% on the first EUR 28,000, 33% on EUR 28,001-50,000, and 43% on everything above EUR 50,000. <strong>No standard deductions remain active</strong> -- the employment income deduction, cuneo fiscale, and trattamento integrativo have all been fully phased out. The only tax reductions come from itemized deductions: pension fund contributions (deductible up to EUR 5,164.57), mortgage interest (19% deduction up to EUR 4,000 of interest), medical expenses, education expenses, and dependent family member deductions.</p>
<p>The <strong>pension fund deduction is at its peak efficiency</strong> at this marginal rate. Contributing EUR 5,164.57 per year saves approximately ${formatCurrency(5164.57 * 0.43, 'en')} in IRPEF annually. This is the single highest-returning risk-free "investment" available to an Italian employee at this income level -- an immediate 43% return on the contributed amount in the form of tax savings.</p>
<p>The regional gap between ${bestRegion.nome} and ${worstRegion.nome} stands at ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month (${formatCurrency((bestRegion.nettoMensile - worstRegion.nettoMensile) * 13, 'en')} per year). Your monthly net is ${formatCurrency(defaultResult.nettoMensile, 'en')}. At this level, engaging a qualified tax advisor (commercialista) for personal fiscal planning is a worthwhile investment that typically pays for itself through identified savings.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(60_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>With ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, a RAL of ${formatCurrency(60_000, 'en')} places you in the top 10% of Italian employees. This is the domain of first-level executives, CTOs of SMEs, senior lawyers, commercial directors, and senior managers at consulting firms. It represents a high level of professional achievement by Italian standards.</p>
<p>The purchasing power of ${formatCurrency(defaultResult.nettoMensile, 'en')} per month provides a very comfortable lifestyle anywhere in Italy. A family of four can live well, save regularly, invest, and enjoy leisure activities. Property ownership in most Italian cities is comfortably accessible. The financial position allows for meaningful wealth building over time, with a reasonable target of accumulating EUR 300,000-500,000 in investments over 15-20 years of disciplined saving and investing.</p>
<p>The persistent concern is the high effective tax rate of ${formatRate(defaultResult.aliquotaMedia, 'en')}. In a European comparison, the same EUR 60,000 gross in Switzerland would yield dramatically higher net pay; in Germany and the Netherlands, the advantage is more moderate but still significant. For executives with international mobility, Italy's taxation at this level is a competitive disadvantage that the regime impatriati (50% taxable income exemption for qualifying returning workers) was specifically designed to address.</p>`,
  },
  65_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(65_000, 'en')} Gross Salary`,
    analysisBody: `<p>A RAL of ${formatCurrency(65_000, 'en')} produces a taxable income of approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')} after INPS deductions. The portion above EUR 50,000 -- roughly ${formatCurrency(defaultResult.imponibileFiscale - 50_000 > 0 ? defaultResult.imponibileFiscale - 50_000 : 0, 'en')} -- is taxed at the maximum 43% IRPEF rate. The marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}, and the effective average rate is ${formatRate(defaultResult.aliquotaMedia, 'en')}.</p>
<p>At this income, the <strong>IRPEF alone on the portion above EUR 50,000</strong> amounts to approximately ${formatCurrency((defaultResult.imponibileFiscale - 50_000 > 0 ? defaultResult.imponibileFiscale - 50_000 : 0) * 0.43, 'en')}. When added to the tax on the lower brackets and the INPS contributions, the total deduction from gross to net is substantial. The all-in marginal rate (INPS + IRPEF + surcharges) on each additional euro exceeds 50%, making gross salary increases feel increasingly unrewarding in net terms.</p>
<p><strong>Regional surcharges</strong> become a significant absolute cost at this taxable base. Regions like Lazio, with progressive rates reaching 3.33% on higher incomes, impose surcharges that can exceed EUR 1,500 per year at this level. The difference between a low-surcharge region like ${bestRegion.nome} and a high-surcharge region like ${worstRegion.nome} is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month.</p>
<p>Key optimization strategies at EUR 65,000 include: <strong>pension fund</strong> at maximum deductible (saving approximately ${formatCurrency(5164.57 * 0.43, 'en')} per year), <strong>supplementary health insurance</strong> through employer (premiums are tax-free up to certain limits), <strong>corporate welfare</strong> plans (EUR 258.23 exempt, or EUR 2,000 for parents), and <strong>charitable donations</strong> (30% deduction up to EUR 30,000 to Third Sector organizations). Monthly net is ${formatCurrency(defaultResult.nettoMensile, 'en')}.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(65_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>A monthly net of ${formatCurrency(defaultResult.nettoMensile, 'en')} from a RAL of ${formatCurrency(65_000, 'en')} puts you in the top 8-10% of Italian employees. This salary level is typical for executives with 3-5 years of seniority, country managers of foreign subsidiaries, junior partners in professional firms, and plant directors. It reflects substantial professional authority and responsibility.</p>
<p>At this income, all basic needs are met with ample margins. The focus shifts from "can I afford this?" to "how do I optimize my wealth?" Property ownership, regular investment contributions (target: ${formatCurrency(defaultResult.nettoMensile * 0.2, 'en')} per month minimum), adequate insurance coverage, and pension planning should all be in place. A family at this level in Italy enjoys a lifestyle comparable to families earning EUR 80,000-90,000 in higher-cost European cities like Munich or Amsterdam.</p>
<p>For internationally mobile professionals, EUR 65,000 in Italy combined with the regime impatriati (50% exemption) effectively doubles the tax efficiency, making Italy temporarily one of the most attractive jurisdictions in Europe. Without this regime, the net gap versus northern European countries remains a persistent challenge for Italian employers trying to recruit senior talent from abroad.</p>`,
  },
  70_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(70_000, 'en')} Gross Salary`,
    analysisBody: `<p>With a RAL of ${formatCurrency(70_000, 'en')}, your taxable income after INPS contributions is approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')}. The amount subject to the top 43% IRPEF bracket -- roughly ${formatCurrency(defaultResult.imponibileFiscale - 50_000 > 0 ? defaultResult.imponibileFiscale - 50_000 : 0, 'en')} -- now constitutes a substantial portion of your taxable base. Your marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}, and the effective average rate has reached ${formatRate(defaultResult.aliquotaMedia, 'en')}.</p>
<p>The <strong>progressive structure of IRPEF</strong> at this level means your tax is calculated in three layers: 23% on the first EUR 28,000 (= EUR 6,440), 33% on EUR 28,001-50,000 (= EUR 7,260), and 43% on everything above EUR 50,000. The third layer now generates a significant IRPEF charge. Combined with INPS contributions of 9.19% on the full RAL and regional/municipal surcharges, the total tax wedge between gross and net is approaching 40% of gross income.</p>
<p>At EUR 70,000, the <strong>regional surcharge impact is particularly pronounced</strong>. Lazio's progressive surcharge, which peaks at 3.33%, can cost over EUR 2,000 per year at this taxable base. In contrast, regions like Friuli-Venezia Giulia or Sardinia apply significantly lower rates. The resulting spread between ${bestRegion.nome} and ${worstRegion.nome} is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month -- substantial enough to justify considering the tax implications of region of residence for remote workers.</p>
<p>Monthly net pay is ${formatCurrency(defaultResult.nettoMensile, 'en')}. The pension fund deduction at 43% marginal rate remains the single most impactful tax optimization: EUR 5,164.57 in contributions yield approximately ${formatCurrency(5164.57 * 0.43, 'en')} in IRPEF savings. Beyond this, structured compensation negotiation -- mixing fixed salary with variable bonuses, benefits, and long-term incentives -- becomes an important lever for maximizing real take-home value.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(70_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>A RAL of ${formatCurrency(70_000, 'en')} yields ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, placing you in the top 7-8% of Italian employees. This is the salary range of corporate executives, CFOs of SMEs, partners at structured professional firms, senior hospital physicians, and senior directors at multinational companies. It signifies a high level of seniority and expertise.</p>
<p>At this income, quality of life in Italy is excellent. A family can live very comfortably in any city, including Milan and Rome. Regular wealth accumulation, premium insurance coverage, and travel are all within easy reach. The focus at this level should be on building a diversified investment portfolio that generates passive income for long-term financial independence.</p>
<p>The effective rate of ${formatRate(defaultResult.aliquotaMedia, 'en')} highlights the heavy tax burden on high Italian salaries. For context, a worker earning EUR 70,000 in Italy takes home roughly EUR 1,000-1,500 less per month than a counterpart at the same gross in Germany, and EUR 2,000-3,000 less than in Switzerland. This gap is the primary driver of the "Italian talent drain" phenomenon that particularly affects senior professionals in tech, finance, and medicine.</p>`,
  },
  80_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(80_000, 'en')} Gross Salary`,
    analysisBody: `<p>A RAL of ${formatCurrency(80_000, 'en')} places your taxable income at approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')} after INPS contributions. A very large portion -- roughly ${formatCurrency(defaultResult.imponibileFiscale - 50_000 > 0 ? defaultResult.imponibileFiscale - 50_000 : 0, 'en')} -- falls in the 43% IRPEF bracket. The marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}, and the effective average rate is ${formatRate(defaultResult.aliquotaMedia, 'en')}, meaning nearly 4 out of every 10 euros of your gross salary go to taxes and contributions.</p>
<p>At this income level, you are beginning to approach the <strong>INPS contribution ceiling</strong> (massimale contributivo), which is set at approximately EUR 119,650 for 2026. While your RAL of EUR 80,000 is still below this ceiling, it is relevant context for career planning: if your salary continues to grow, the portion above EUR 119,650 will no longer be subject to INPS employee contributions (9.19%), which slightly improves the net-to-gross ratio on income above the ceiling but also reduces future pension accruals.</p>
<p>The <strong>IRPEF structure at EUR 80,000</strong> is heavily weighted toward the top bracket: approximately ${formatCurrency((defaultResult.imponibileFiscale - 50_000 > 0 ? defaultResult.imponibileFiscale - 50_000 : 0) * 0.43, 'en')} of your total IRPEF comes from the 43% bracket alone. Regional surcharges at this taxable base are significant -- the difference between a low-rate region like ${bestRegion.nome} and a high-rate region like ${worstRegion.nome} is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month, or over ${formatCurrency((bestRegion.nettoMensile - worstRegion.nettoMensile) * 13, 'en')} per year.</p>
<p>Monthly net is ${formatCurrency(defaultResult.nettoMensile, 'en')}. Optimization strategies include: pension fund (saving approximately ${formatCurrency(5164.57 * 0.43, 'en')} per year at 43% marginal rate), <strong>stock options or equity compensation</strong> (which may benefit from a flat 26% capital gains rate rather than progressive IRPEF), and negotiation of extensive benefit packages (company car, international health insurance, executive welfare). A dedicated tax advisor (commercialista) is essential at this level.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(80_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>With ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, a RAL of ${formatCurrency(80_000, 'en')} places you in the top 5% of Italian employees. This is the territory of general managers, managing directors of multinational subsidiaries, senior partners, C-level executives of mid-sized companies, and chief physicians at large hospitals. It represents the upper echelon of Italian salaried employment.</p>
<p>The standard of living at this net income is high by any Italian measure. Property ownership, comfortable family life, regular international travel, and significant savings are all well within reach. A target net worth of EUR 400,000-600,000 in liquid investments (excluding primary residence) after 15-20 years of career at this level is realistic with disciplined financial management.</p>
<p>However, the effective rate of ${formatRate(defaultResult.aliquotaMedia, 'en')} represents a heavy price for Italian residency. At EUR 80,000, the gross-to-net conversion is particularly unfavorable compared to many OECD peers. The regime impatriati, which exempts 50% of taxable income for qualifying returning workers, transforms this salary into one of the most attractive net propositions in Europe -- but requires having lived abroad for at least 3 tax years prior to returning. This mechanism is Italy's primary tool for competing for high-income talent.</p>`,
  },
  90_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(90_000, 'en')} Gross Salary`,
    analysisBody: `<p>With a RAL of ${formatCurrency(90_000, 'en')}, your fiscal taxable income after INPS is approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')}. The portion in the 43% IRPEF bracket -- roughly ${formatCurrency(defaultResult.imponibileFiscale - 50_000 > 0 ? defaultResult.imponibileFiscale - 50_000 : 0, 'en')} -- now dominates your tax calculation. The marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}, and the effective average rate is ${formatRate(defaultResult.aliquotaMedia, 'en')}.</p>
<p>At EUR 90,000, the <strong>INPS contribution ceiling</strong> of approximately EUR 119,650 is increasingly relevant for planning purposes. Your current RAL is still fully subject to INPS employee contributions at 9.19%, but you are within one or two promotions of the ceiling. Understanding this threshold is important because once your salary exceeds it, the excess is exempt from employee INPS contributions, slightly improving take-home pay but reducing the portion of salary that accrues pension benefits.</p>
<p>The <strong>total annual tax burden</strong> at this RAL is substantial: INPS contributions, IRPEF across all three brackets, and regional/municipal surcharges combine to take roughly ${formatRate(defaultResult.aliquotaMedia, 'en')} of your gross income. The absolute amounts are striking -- you pay more in total taxes and contributions than many Italian workers earn in gross salary. This makes every optimization opportunity valuable: the pension fund deduction at 43% saves approximately ${formatCurrency(5164.57 * 0.43, 'en')} per year; charitable donations to qualifying organizations can return 30% of the donated amount; deductible insurance premiums reduce IRPEF at 19%.</p>
<p>Between ${bestRegion.nome} and ${worstRegion.nome}, the monthly gap is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')}. Monthly net is ${formatCurrency(defaultResult.nettoMensile, 'en')}. At this level, the annual cost of professional tax advice (EUR 1,500-3,000) is easily justified by the savings it identifies.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(90_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>A RAL of ${formatCurrency(90_000, 'en')} produces ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, placing you firmly in the top 3-4% of Italian employees. This salary is achieved by CEOs of mid-sized companies, managing partners, renowned physicians, and SVPs at major multinational corporations. It represents exceptional professional achievement in the Italian context.</p>
<p>At this income, financial comfort is assured. The question is no longer about affordability but about optimization and wealth building. A reasonable savings target at this level -- after maximizing pension fund contributions and covering all lifestyle costs -- is EUR 1,500-2,500 per month in diversified investments. Over 15-20 years, this builds substantial financial independence.</p>
<p>The effective rate of ${formatRate(defaultResult.aliquotaMedia, 'en')} is among the highest in Europe for this income level. In purely financial terms, equivalent roles in Switzerland, the UK, or even Germany offer significantly higher net compensation. Italy's counter-argument rests on quality of life, climate, cultural richness, and the healthcare system -- intangible benefits that many high-earning professionals value highly but that do not appear on a payslip.</p>`,
  },
  100_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(100_000, 'en')} Gross Salary`,
    analysisBody: `<p>A RAL of ${formatCurrency(100_000, 'en')} -- a symbolic threshold in the Italian labor market -- generates a fiscal taxable income of approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')} after INPS contributions. The amount in the 43% IRPEF bracket is now very substantial: roughly ${formatCurrency(defaultResult.imponibileFiscale - 50_000 > 0 ? defaultResult.imponibileFiscale - 50_000 : 0, 'en')}. The marginal rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}, and the effective average rate is ${formatRate(defaultResult.aliquotaMedia, 'en')}.</p>
<p>The <strong>INPS contribution ceiling</strong> (massimale contributivo, approximately EUR 119,650 for 2026) is now within close range. At EUR 100,000, the entire RAL is still subject to INPS employee contributions at 9.19%, which amounts to approximately ${formatCurrency(100_000 * 0.0919, 'en')} per year. If your salary grows to exceed EUR 119,650, the portion above will be exempt from employee INPS, creating a somewhat counterintuitive effect where higher gross yields proportionally better net on the margin -- but at the cost of reduced pension accrual on that excess income.</p>
<p>At this income level, the <strong>regime impatriati</strong> (expatriate tax regime) deserves special attention for eligible workers. The regime exempts 50% of taxable income from IRPEF for workers who transfer their tax residence to Italy after at least 3 years abroad. At a RAL of EUR 100,000, this translates to annual tax savings exceeding ${formatCurrency(100_000 * 0.15, 'en')} -- a transformative difference that makes Italy temporarily one of the most attractive jurisdictions in Europe for qualifying high-income professionals.</p>
<p>Regional variation between ${bestRegion.nome} and ${worstRegion.nome} is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month. Monthly net is ${formatCurrency(defaultResult.nettoMensile, 'en')}. Tax planning at this level should be comprehensive: pension fund maximization, structured compensation (salary + MBO + benefits), review of all available deductions, and potentially a family-level tax strategy if a spouse has income.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(100_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>At ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, a RAL of ${formatCurrency(100_000, 'en')} places you in the top 2-3% of Italian employees. This salary is the domain of CEOs with eight-figure revenue companies, equity partners at top law firms, chief physicians at major hospitals, and country managers of Fortune 500 companies. It is, unambiguously, a high salary by Italian standards.</p>
<p>The standard of living is excellent: premium housing, regular international travel, private education for children if desired, and robust savings are all comfortably achievable. A family earning EUR 100,000 in Italy (even as a single income) enjoys a lifestyle that, accounting for the lower cost of goods, dining, and healthcare, can rival households earning EUR 130,000-140,000 in London or Munich.</p>
<p>The persistent tension is the effective rate of ${formatRate(defaultResult.aliquotaMedia, 'en')}: Italy takes a larger share of high incomes than most comparable economies. The net gap versus Switzerland is roughly EUR 2,000-3,000 per month at this gross level. For many at this salary, the decision to stay in Italy is ultimately a lifestyle choice rather than a financial optimization -- and Italy makes a compelling case on quality of life, even if the payslip tells a different story.</p>`,
  },
  120_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(120_000, 'en')} Gross Salary`,
    analysisBody: `<p>A RAL of ${formatCurrency(120_000, 'en')} puts you at the threshold of the <strong>INPS contribution ceiling</strong> (massimale contributivo, approximately EUR 119,650 for 2026). Your fiscal taxable income after INPS is approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')}, and the portion in the 43% IRPEF bracket -- roughly ${formatCurrency(defaultResult.imponibileFiscale - 50_000 > 0 ? defaultResult.imponibileFiscale - 50_000 : 0, 'en')} -- dominates the tax calculation. Marginal rate: ${formatRate(defaultResult.aliquotaMarginale, 'en')}. Effective rate: ${formatRate(defaultResult.aliquotaMedia, 'en')}.</p>
<p>The <strong>INPS ceiling effect</strong> is the distinctive fiscal feature at EUR 120,000. ${ral > 119_650 ? 'Since your RAL exceeds the ceiling of EUR 119,650, the portion above -- approximately ' + formatCurrency(ral - 119_650, 'en') + ' -- is not subject to the 9.19% employee INPS contribution. This saves roughly ' + formatCurrency((ral - 119_650) * 0.0919, 'en') + ' per year in contributions, slightly improving net pay. However, this also means no pension contributions accrue on the excess, creating a growing gap between your salary level and your future public pension, which makes supplementary pension planning essential.' : 'Your RAL is very close to the ceiling. Once your salary exceeds it, the portion above will be exempt from INPS employee contributions, slightly improving net pay but capping pension accrual.'}</p>
<p>At this income level, the <strong>regime impatriati</strong> is extraordinarily valuable for eligible workers. A 50% exemption on taxable income at EUR 120,000 means approximately half of your income is shielded from IRPEF, generating annual savings that can exceed ${formatCurrency(120_000 * 0.17, 'en')}. This is arguably the strongest tax incentive Italy offers and is specifically designed to attract high-income professionals from abroad.</p>
<p>The regional spread between ${bestRegion.nome} and ${worstRegion.nome} is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month. Monthly net is ${formatCurrency(defaultResult.nettoMensile, 'en')}. Wealth structuring becomes a priority at this level: consider a societa semplice (simple partnership) for investment management, life insurance policies with Luxembourgish law for asset protection and tax deferral, and comprehensive succession planning.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(120_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>A monthly net of ${formatCurrency(defaultResult.nettoMensile, 'en')} from a RAL of ${formatCurrency(120_000, 'en')} places you in the top 1-2% of Italian employees. This salary is reserved for CEOs and general directors of large companies, managing partners of top-tier firms, country managers of global multinationals, and top executives in banking and insurance. It is an elite salary by any national measure.</p>
<p>Quality of life at this level is premium by Italian standards. Housing, education, travel, leisure -- none present a financial constraint. The primary financial focus should be wealth preservation and growth: diversified investment portfolio, adequate insurance (including umbrella liability), tax-efficient structures, and estate planning. A target net worth of EUR 1,000,000+ in liquid assets within 10-15 years of earning at this level is a reasonable goal.</p>
<p>The effective rate of ${formatRate(defaultResult.aliquotaMedia, 'en')} remains a point of tension. At EUR 120,000, Italy is among the heaviest-taxing countries in the OECD for salaried workers. The regime impatriati can dramatically change this calculus for those who qualify, but for long-term Italian residents, the tax burden is a permanent feature of earning at this level. The trade-off -- Italian quality of life versus northern European or Swiss net pay -- is a deeply personal decision that goes beyond pure economics.</p>`,
  },
  150_000: {
    analysisTitle: `Tax Analysis for a ${formatCurrency(150_000, 'en')} Gross Salary`,
    analysisBody: `<p>A RAL of ${formatCurrency(150_000, 'en')} is well above the <strong>INPS contribution ceiling</strong> of approximately EUR 119,650. Your fiscal taxable income is approximately ${formatCurrency(defaultResult.imponibileFiscale, 'en')}, with the amount in the 43% IRPEF bracket reaching roughly ${formatCurrency(defaultResult.imponibileFiscale - 50_000 > 0 ? defaultResult.imponibileFiscale - 50_000 : 0, 'en')}. The marginal IRPEF rate is ${formatRate(defaultResult.aliquotaMarginale, 'en')}, and the effective average rate is ${formatRate(defaultResult.aliquotaMedia, 'en')}.</p>
<p>The <strong>INPS ceiling creates a unique fiscal dynamic</strong> at this RAL. The portion exceeding EUR 119,650 -- approximately ${formatCurrency(ral - 119_650, 'en')} -- is not subject to the 9.19% employee INPS contribution. This saves roughly ${formatCurrency((ral - 119_650) * 0.0919, 'en')} per year compared to what would be owed if the ceiling did not exist. However, this excess also does not generate pension contribution accruals, creating a substantial pension gap. At EUR 150,000, your eventual public pension (pensione pubblica) will be calculated as if you earned EUR 119,650, making supplementary pension planning through a complementary pension fund (fondo pensione) not just advisable but essential.</p>
<p>The <strong>regime impatriati</strong> at EUR 150,000 delivers its maximum absolute value. The 50% taxable income exemption produces annual IRPEF savings exceeding ${formatCurrency(150_000 * 0.17, 'en')}, making Italy temporarily one of the most tax-efficient countries in Europe for qualifying high-income professionals. This is the primary mechanism through which Italy competes globally for executive talent, and at EUR 150,000 its impact is transformative.</p>
<p>Between ${bestRegion.nome} and ${worstRegion.nome}, the difference is ${formatCurrency(bestRegion.nettoMensile - worstRegion.nettoMensile, 'en')} per month. Monthly net is ${formatCurrency(defaultResult.nettoMensile, 'en')}. At this wealth level, professional financial management is not optional: a team of commercialista (tax advisor), independent financial advisor, and notary for succession planning is standard practice. Consider structuring family wealth through a societa semplice or trust to optimize both current taxation and future inheritance.</p>`,
    goodSalaryTitle: `Is ${formatCurrency(150_000, 'en')} a Good Salary in Italy?`,
    goodSalaryBody: `<p>At ${formatCurrency(defaultResult.nettoMensile, 'en')} net per month, a RAL of ${formatCurrency(150_000, 'en')} places you in the top 0.5-1% of Italian employees. This salary is reserved for the highest tier of the Italian corporate world: CEOs of major industrial groups, partners at top international law firms, general directors of large banks, and country heads of Fortune 500 companies. It is, by any measure, an elite compensation.</p>
<p>Quality of life at this level is the best that Italy can offer: premium housing in the most desirable neighborhoods, international schools for children, extensive travel, and the ability to accumulate significant wealth. A family at EUR 150,000 in Italy -- particularly in cities like Milan, Rome, or Florence -- enjoys a lifestyle that combines Italian cultural richness with the financial comfort typical of the highest international professional tiers.</p>
<p>The effective rate of ${formatRate(defaultResult.aliquotaMedia, 'en')} means nearly half of gross income goes to the state. This is the price of Italian residency at this income level. For those with international options, the calculus is stark: the same EUR 150,000 in Dubai produces zero income tax; in Switzerland (depending on canton), the effective rate would be 15-25%; even in the UK, the net would be substantially higher. Italy's value proposition at this salary is lifestyle, not tax efficiency -- and for many who earn at this level, that proposition is compelling enough to stay.</p>`,
  },
};

